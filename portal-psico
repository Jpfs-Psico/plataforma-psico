  // ---------- Utilidades ----------
  // Parseo de fechas "YYYY-MM-DD" en horario LOCAL (sin pasar por UTC),
  // que es la misma representación que usa <input type="date">. Esto evita
  // el desfase de un día que ocurría al usar `new Date(fechaStr)`, ya que
  // ese constructor interpreta cadenas "solo fecha" como medianoche UTC y,
  // al convertirlas a la hora local (p. ej. UTC-5 en Perú), retrocede al
  // día anterior. calcularEdad() y fmtFecha() ahora comparten esta misma
  // función, de modo que "Ver datos" y "Editar" siempre muestran la fecha
  // idéntica y sincronizada.
  function parseFechaLocal(fechaStr){
    if (!fechaStr) return null;
    const partes = String(fechaStr).split('-');
    if (partes.length !== 3) return null;
    const [y, m, d] = partes.map(Number);
    if (!y || !m || !d) return null;
    return new Date(y, m - 1, d);
  }
  function calcularEdad(fechaStr){
    const nac = parseFechaLocal(fechaStr);
    if (!nac) return null;
    const hoy = new Date();
    let edad = hoy.getFullYear() - nac.getFullYear();
    const m = hoy.getMonth() - nac.getMonth();
    if (m < 0 || (m === 0 && hoy.getDate() < nac.getDate())) edad--;
    return edad;
  }
  function fmtFecha(f){
    const d = parseFechaLocal(f);
    if (!d) return '—';
    return d.toLocaleDateString('es-PE', {year:'numeric', month:'long', day:'numeric'});
  }

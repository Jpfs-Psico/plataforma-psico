  .doc-letterhead-sub{ font-size:.8125rem; color:var(--ink-muted); margin-top:6px; }
  .doc-letterhead-row{ display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:16px; }
  .doc-letterhead-left{ text-align:left; font-size:.75rem; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-muted); font-weight:700; }
  .doc-letterhead-center{ text-align:center; font-family:'Plus Jakarta Sans',sans-serif; letter-spacing:.02em; font-size:1.25rem; font-weight:800; text-transform:uppercase; }

  .doc-section{ margin-bottom:26px; page-break-inside:avoid; }
  .doc-section-title{
    font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:.9375rem;
    letter-spacing:.02em; text-transform:uppercase; color:var(--primary);
    padding-bottom:8px; margin-bottom:14px; border-bottom:1px solid var(--border);
  }
  .doc-justify{
    text-align:justify; text-justify:inter-word; line-height:1.75; font-size:.9375rem;
    color:var(--ink); white-space:pre-line; hyphens:auto;
  }
  .doc-ident-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:14px 32px;
    background:var(--surface-alt); border:1px solid var(--border); border-radius:12px; padding:20px 24px;
  }
  .doc-ident-item{ display:flex; flex-direction:column; gap:2px; }
  .doc-ident-label{ font-size:.6875rem; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-muted); font-weight:700; }
  .doc-ident-value{ font-size:.9375rem; font-weight:600; color:var(--ink); }
  .doc-kv-row{ display:flex; justify-content:space-between; gap:16px; padding:8px 0; border-bottom:1px dashed var(--border); font-size:.9375rem; }
  .doc-kv-row:last-child{ border-bottom:none; }
  .doc-kv-label{ color:var(--ink-muted); font-weight:600; }

  .doc-signature{ margin-top:64px; text-align:center; page-break-inside:avoid; }
  .doc-signature-line{ width:280px; margin:0 auto 10px; border-top:1px solid var(--ink); }
  .doc-signature-name{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:700; font-size:.9375rem; }
  .doc-signature-role{ font-size:.8125rem; color:var(--ink-muted); margin-top:2px; letter-spacing:.01em; }

  @media print{
    .doc-letterhead{ border-bottom-color:#000; }
    .doc-section-title{ color:#000; }
    .doc-ident-grid{ background:#fff; border-color:#999; }
    .doc-signature-line{ border-top-color:#000; }
  }

  /* ---- Observaciones (tabla) + popover ---- */
  .obs-chip{ display:inline-flex; align-items:center; gap:.4rem; max-width:200px; padding:.25rem .65rem; border-radius:999px; font-size:.75rem; font-weight:600; color:var(--primary); background:var(--primary-soft); border:1px solid transparent; cursor:pointer; transition:border-color .2s var(--ease), background .2s var(--ease); }
  .obs-chip:hover, .obs-chip:focus-visible{ border-color:var(--primary); outline:none; }

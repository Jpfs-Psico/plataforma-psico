  /* ==========================================================================
     PESTAÑA SEGUIMIENTO DEL PERFIL — columna principal amplia + lateral de reportes
     ========================================================================== */
  /* Tres tarjetas con el mismo padding, radio y separación (1.5rem), alineadas por su borde superior.
     ≥1280px: Estado (compacto) | Seguimiento psicológico (flexible) | Reportes e informes.
     1024–1279px: Estado | Seguimiento psicológico, y los Reportes centrados debajo. <1024px: una sola columna. */
  #perfilGridSeguimiento.seg-grid{ display:grid; grid-template-columns:minmax(0,1fr); gap:1.5rem; align-items:start; }

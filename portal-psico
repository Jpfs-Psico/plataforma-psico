        <thead>
          <tr>
            <th class="text-left text-xs uppercase tracking-wide text-[var(--ink-muted)] pb-2">Apellidos y Nombres</th>
            <th class="text-left text-xs uppercase tracking-wide text-[var(--ink-muted)] pb-2">Institución</th>

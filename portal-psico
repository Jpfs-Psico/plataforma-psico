  // ---------- Orden automático de la tabla ----------
  // Se agrupa por institución (orden alfabético) y dentro de cada grupo:
  //  · Cetemin: nuevos registros → "Cursando ciclo" → otros estados → "Egresado" / "Curso pendiente / Subsanación"
  //  · USS: por ciclo, de menor a mayor
  //  · Resto: alfabético por apellidos
  const NUEVOS_KEY = 'synapsis_nuevos_estudiantes';
  const NUEVO_VIGENCIA_MS = 7 * 24 * 60 * 60 * 1000; // un registro nuevo se mantiene al inicio por 7 días
  function leerNuevos(){
    try {
      const o = JSON.parse(localStorage.getItem(NUEVOS_KEY) || '{}');
      const ahora = Date.now();
      Object.keys(o).forEach(k => { if (ahora - o[k] > NUEVO_VIGENCIA_MS) delete o[k]; });
      return o;
    } catch (e) { return {}; }
  }
  function marcarNuevo(dni){
    try {
      const o = leerNuevos();
      o[String(dni)] = Date.now();
      localStorage.setItem(NUEVOS_KEY, JSON.stringify(o));
    } catch (e) { /* sin almacenamiento local: el registro simplemente no se destaca */ }
  }
  function cicloNumero(c){
    const s = String(c || '').trim().toUpperCase();
    const dig = s.match(/\d+/);
    if (dig) return parseInt(dig[0], 10);
    const rom = s.match(/^[IVXLC]+(?![A-Z])/);
    if (rom) {
      const v = { I: 1, V: 5, X: 10, L: 50, C: 100 };
      let total = 0;
      const r = rom[0];
      for (let i = 0; i < r.length; i++) {
        const cur = v[r[i]], sig = v[r[i + 1]] || 0;
        total += cur < sig ? -cur : cur;
      }
      return total;
    }
    return 999; // sin ciclo ("-" o vacío): al final del grupo
  }
  function rangoCetemin(e, nuevos){
    if (nuevos[String(e.dni)]) return 0;
    if (e.estado_academico === 'Cursando ciclo') return 1;
    if (e.estado_academico === 'Egresado' || e.estado_academico === 'Curso pendiente / Subsanación') return 3;
    return 2;
  }
  function compararEstudiantes(a, b, nuevos){
    const ia = String(a.institucion || '').trim().toLowerCase();
    const ib = String(b.institucion || '').trim().toLowerCase();
    if (ia !== ib) return ia.localeCompare(ib, 'es');
    let ra = 0, rb = 0;
    if (ia === 'cetemin') { ra = rangoCetemin(a, nuevos); rb = rangoCetemin(b, nuevos); }
    else if (ia === 'uss') { ra = cicloNumero(a.ciclo); rb = cicloNumero(b.ciclo); }
    if (ra !== rb) return ra - rb;
    return `${a.apellidos} ${a.nombres}`.localeCompare(`${b.apellidos} ${b.nombres}`, 'es', { sensitivity: 'base' });
  }

  function renderTabla(){
    const inst = $('filtroInstitucion').value;
    const ciclo = $('filtroCiclo').value;
    const estadoF = $('filtroEstado').value;
    const estadoAcadF = $('filtroEstadoAcademico').value;
    const rendF = $('filtroRendimiento').value;
    const q = $('filtroBusqueda').value.trim().toLowerCase();

    const nuevos = leerNuevos();
    const filtrados = estudiantes.filter(e =>
      (!inst || e.institucion === inst) &&
      (!ciclo || normCiclo(e.ciclo) === ciclo) &&
      (!estadoF || normalizarEstado(e.estado_actual) === estadoF) &&
      (!estadoAcadF || e.estado_academico === estadoAcadF) &&
      (!rendF || e.rendimiento_academico === rendF) &&
      (!q || `${e.apellidos} ${e.nombres} ${e.dni}`.toLowerCase().includes(q))
    ).sort((a, b) => compararEstudiantes(a, b, nuevos));

    const tbody = $('tablaEstudiantes');
    tbody.innerHTML = '';
    $('listaVacia').classList.toggle('hidden', filtrados.length > 0);

    filtrados.forEach(e => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="px-5 py-3 celda-izq">
          <button class="font-semibold text-[var(--primary)] hover:underline abrir-perfil text-left">${e.apellidos}, ${e.nombres}</button>
        </td>
        <td class="px-5 py-3 font-mono text-xs">${e.dni}</td>
        <td class="px-5 py-3">${e.institucion}</td>
        <td class="px-5 py-3 celda-carrera"><span class="carrera-texto">${(e.carrera || '—').replace(/\s*\/\s*/g, ' / ')}</span></td>
        <td class="px-5 py-3">${e.ciclo || '—'}</td>
        <td class="px-5 py-3">${estadoAcademicoSelectHTML(e.estado_academico)}</td>
        <td class="px-5 py-3">${rendimientoSelectHTML(e.rendimiento_academico)}</td>
        <td class="px-5 py-3">${situacionLaboralSelectHTML(e.situacion_laboral)}</td>
        <td class="px-5 py-3">${estadoBadgeHTML(e.estado_actual)}</td>
        <td class="px-5 py-3">${observacionCeldaHTML(e.observaciones)}</td>
        <td class="px-5 py-3">
          <div class="acciones-wrap">
            <button class="btn-ghost rounded-lg px-3 py-1.5 text-xs font-semibold btn-ver-datos inline-flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              Ver datos
            </button>
            <button class="btn-ghost rounded-lg px-3 py-1.5 text-xs font-semibold btn-editar">Editar</button>
            <button class="btn-danger rounded-lg px-3 py-1.5 text-xs font-semibold btn-eliminar">Eliminar</button>
          </div>
        </td>`;
      tr.querySelector('.abrir-perfil').addEventListener('click', () => abrirPerfil(e.dni));
      tr.querySelector('.btn-ver-datos').addEventListener('click', () => abrirVerDatos(e));
      tr.querySelector('.btn-editar').addEventListener('click', () => abrirModalEditar(e));
      tr.querySelector('.btn-eliminar').addEventListener('click', () => eliminarEstudiante(e));
      const btnObs = tr.querySelector('.btn-obs');
      if (btnObs) {
        const nombreObs = `${e.apellidos}, ${e.nombres}`;
        btnObs.addEventListener('mouseenter', () => mostrarPopObs(btnObs, nombreObs, e.observaciones));
        btnObs.addEventListener('mouseleave', ocultarPopObs);
        btnObs.addEventListener('focus', () => mostrarPopObs(btnObs, nombreObs, e.observaciones));
        btnObs.addEventListener('blur', ocultarPopObs);
        btnObs.addEventListener('click', (ev) => { ev.stopPropagation(); mostrarPopObs(btnObs, nombreObs, e.observaciones); });
      }

      // Edición directa del estado académico: guarda de inmediato en Supabase
      const selectEstadoAcademico = tr.querySelector('.estado-academico-select');
      selectEstadoAcademico.addEventListener('click', (ev) => ev.stopPropagation());
      selectEstadoAcademico.addEventListener('change', async (ev) => {
        const valorAnterior = ESTADOS_ACADEMICOS_INFO[e.estado_academico] ? e.estado_academico : 'Matriculado';
        const nuevoValor = ev.target.value;
        ev.target.disabled = true;
        let { data, error } = await supabaseClient
          .from('estudiantes')
          .update(ESTADOS_BAJA.includes(nuevoValor) ? { estado_academico: nuevoValor, estado_actual: '-' } : { estado_academico: nuevoValor })
          .eq('dni', e.dni).select('dni');
        ev.target.disabled = false;
        if (!error && !(data && data.length)) error = { message: 'Supabase no actualizó el registro (revisa las políticas RLS del script SQL integral).' };
        if (error) {
          alert('No se pudo actualizar el estado académico: ' + error.message);
          ev.target.value = valorAnterior;
          return;
        }
        e.estado_academico = nuevoValor;
        if (ESTADOS_BAJA.includes(nuevoValor)) { e.estado_actual = '-'; renderTabla(); return; }
        ev.target.style.cssText = estadoAcademicoEstilo(nuevoValor);
      });

      // Edición directa del rendimiento académico: guarda de inmediato en Supabase
      const selectRendimiento = tr.querySelector('.rendimiento-select');
      selectRendimiento.addEventListener('click', (ev) => ev.stopPropagation());
      selectRendimiento.addEventListener('change', async (ev) => {
        const valorAnterior = RENDIMIENTO_INFO[e.rendimiento_academico] ? e.rendimiento_academico : '';
        const nuevoValor = ev.target.value;
        ev.target.disabled = true;
        let { data, error } = await supabaseClient
          .from('estudiantes')
          .update({ rendimiento_academico: nuevoValor || null })
          .eq('dni', e.dni).select('dni');
        ev.target.disabled = false;
        if (!error && !(data && data.length)) error = { message: 'Supabase no actualizó el registro (revisa las políticas RLS del script SQL integral).' };
        if (error) {
          alert('No se pudo actualizar el rendimiento académico: ' + error.message +
            (/rendimiento_academico/i.test(error.message) ? '\n\nEjecuta primero en Supabase: ALTER TABLE estudiantes ADD COLUMN rendimiento_academico text;' : ''));
          ev.target.value = valorAnterior;
          return;
        }
        e.rendimiento_academico = nuevoValor || null;
        ev.target.style.cssText = rendimientoEstilo(nuevoValor);
      });

      // Guardado inmediato de un campo de la fila (el Dashboard lee estos mismos datos)
      const guardarCampo = async (campo, valor) => {
        let { data, error } = await supabaseClient.from('estudiantes').update({ [campo]: valor }).eq('dni', e.dni).select('dni');
        if (!error && !(data && data.length)) error = { message: 'Supabase no actualizó el registro (revisa las políticas RLS del script SQL integral).' };
        if (error) {
          alert('No se pudo guardar: ' + error.message + (/column/i.test(error.message) ? '\n\nEjecuta primero el script SQL del módulo de dashboards en Supabase.' : ''));
          return false;
        }
        e[campo] = valor;
        return true;
      };
      const selSit = tr.querySelector('.sit-select');
      selSit.addEventListener('click', (ev) => ev.stopPropagation());
      selSit.addEventListener('change', async (ev) => {
        const previo = SIT_ESTILO[e.situacion_laboral] ? e.situacion_laboral : '';
        ev.target.disabled = true;
        const ok = await guardarCampo('situacion_laboral', ev.target.value || null);
        ev.target.disabled = false;
        if (!ok) { ev.target.value = previo; return; }
        ev.target.style.cssText = sitEstilo(ev.target.value);
      });
      tbody.appendChild(tr);
    });
  }

  ['filtroInstitucion','filtroCiclo','filtroEstado','filtroEstadoAcademico','filtroRendimiento'].forEach(id => $(id).addEventListener('change', renderTabla));
  $('filtroBusqueda').addEventListener('input', renderTabla);

  // ---------- Campos dinámicos: vivienda y convivencia ----------
  const campoModalidadVivienda = $('campoModalidadVivienda');
  const campoGrupoMontoAlquiler = $('campoGrupoMontoAlquiler');
  const campoMontoAlquiler = $('campoMontoAlquiler');
  const campoGrupoPagaAlquilerFamiliar = $('campoGrupoPagaAlquilerFamiliar');
  const campoPagaAlquilerFamiliar = $('campoPagaAlquilerFamiliar');
  const campoGrupoMontoAlquilerFamiliar = $('campoGrupoMontoAlquilerFamiliar');
  const campoMontoAlquilerFamiliar = $('campoMontoAlquilerFamiliar');
  const campoConvivencia = $('campoConvivencia');
  const campoGrupoConvivenciaDetalle = $('campoGrupoConvivenciaDetalle');
  const campoConvivenciaDetalle = $('campoConvivenciaDetalle');

  campoModalidadVivienda.addEventListener('change', () => {
    const esAlquilado = campoModalidadVivienda.value === 'Casa o cuarto alquilado';
    campoGrupoMontoAlquiler.classList.toggle('hidden', !esAlquilado);
    campoMontoAlquiler.required = esAlquilado;
    if (!esAlquilado) campoMontoAlquiler.value = '';

    const esFamiliar = campoModalidadVivienda.value === 'Vivienda de algún familiar';
    campoGrupoPagaAlquilerFamiliar.classList.toggle('hidden', !esFamiliar);
    campoPagaAlquilerFamiliar.required = esFamiliar;
    if (!esFamiliar) {
      campoPagaAlquilerFamiliar.value = '';
      campoGrupoMontoAlquilerFamiliar.classList.add('hidden');
      campoMontoAlquilerFamiliar.required = false;
      campoMontoAlquilerFamiliar.value = '';
    }
  });

  campoPagaAlquilerFamiliar.addEventListener('change', () => {
    const paga = campoPagaAlquilerFamiliar.value === 'Sí';
    campoGrupoMontoAlquilerFamiliar.classList.toggle('hidden', !paga);
    campoMontoAlquilerFamiliar.required = paga;
    if (!paga) campoMontoAlquilerFamiliar.value = '';
  });

  campoConvivencia.addEventListener('change', () => {
    const conAlguien = campoConvivencia.value === 'Con alguien';
    campoGrupoConvivenciaDetalle.classList.toggle('hidden', !conAlguien);
    campoConvivenciaDetalle.required = conAlguien;
    if (!conAlguien) campoConvivenciaDetalle.value = '';
  });

  function sincronizarCamposViviendaVisual(){
    const esAlquilado = campoModalidadVivienda.value === 'Casa o cuarto alquilado';
    campoGrupoMontoAlquiler.classList.toggle('hidden', !esAlquilado);
    campoMontoAlquiler.required = esAlquilado;

    const esFamiliar = campoModalidadVivienda.value === 'Vivienda de algún familiar';
    campoGrupoPagaAlquilerFamiliar.classList.toggle('hidden', !esFamiliar);
    campoPagaAlquilerFamiliar.required = esFamiliar;
    const pagaFamiliar = campoPagaAlquilerFamiliar.value === 'Sí';
    campoGrupoMontoAlquilerFamiliar.classList.toggle('hidden', !(esFamiliar && pagaFamiliar));
    campoMontoAlquilerFamiliar.required = esFamiliar && pagaFamiliar;

    const conAlguien = campoConvivencia.value === 'Con alguien';
    campoGrupoConvivenciaDetalle.classList.toggle('hidden', !conAlguien);
    campoConvivenciaDetalle.required = conAlguien;
  }

  // ---------- Campo dinámico: estado laboral actual ----------
  const campoTrabajaActualmente = $('campoTrabajaActualmente');
  const campoGrupoLugarTrabajo = $('campoGrupoLugarTrabajo');
  const campoLugarTrabajo = $('campoLugarTrabajo');
  const campoGrupoOcupacionActual = $('campoGrupoOcupacionActual');
  const campoOcupacionActual = $('campoOcupacionActual');
  const campoGrupoHorarioTrabajo = $('campoGrupoHorarioTrabajo');
  const campoHorarioTrabajo = $('campoHorarioTrabajo');

  function sincronizarCampoLaboralVisual(){
    const trabaja = campoTrabajaActualmente.value === 'Sí';
    [campoGrupoLugarTrabajo, campoGrupoOcupacionActual, campoGrupoHorarioTrabajo].forEach(grp => grp.classList.toggle('hidden', !trabaja));
    campoLugarTrabajo.required = trabaja;
    campoOcupacionActual.required = trabaja;
    campoHorarioTrabajo.required = trabaja;
  }
  campoTrabajaActualmente.addEventListener('change', () => {
    sincronizarCampoLaboralVisual();
    if (campoTrabajaActualmente.value !== 'Sí') {
      campoLugarTrabajo.value = '';
      campoOcupacionActual.value = '';
      campoHorarioTrabajo.value = '';
    }
  });

  // ---------- Cuadro dinámico: composición familiar ----------
  const PARENTESCOS = ['Padre','Madre','Hermano/a','Tutor/a','Abuelo/a','Tío/a','Primo/a','Otro'];
  const SITUACIONES_FAMILIA = ['Vive con el estudiante','No vive con él','Fallecido'];
  function escapeAttr(s){ return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;'); }

  function crearFilaFamiliar(datos = {}){
    const tr = document.createElement('tr');
    tr.style.borderTop = '1px solid var(--border)';
    tr.innerHTML = `
      <td class="p-1.5"><input class="fam-nombre w-full rounded-lg px-2 py-1.5 text-sm" value="${datos.nombre ? escapeAttr(datos.nombre) : ''}" placeholder="Apellidos y nombres"></td>
      <td class="p-1.5">
        <select class="fam-parentesco w-full rounded-lg px-2 py-1.5 text-sm">
          <option value="" ${!datos.parentesco ? 'selected' : ''} disabled>Selecciona</option>
          ${PARENTESCOS.map(op => `<option ${datos.parentesco === op ? 'selected' : ''}>${op}</option>`).join('')}
        </select>
      </td>
      <td class="p-1.5"><input type="number" min="0" class="fam-edad w-full rounded-lg px-2 py-1.5 text-sm" value="${datos.edad !== undefined && datos.edad !== null ? datos.edad : ''}"></td>
      <td class="p-1.5"><input class="fam-ocupacion w-full rounded-lg px-2 py-1.5 text-sm" value="${datos.ocupacion ? escapeAttr(datos.ocupacion) : ''}"></td>
      <td class="p-1.5">
        <select class="fam-situacion w-full rounded-lg px-2 py-1.5 text-sm">
          <option value="" ${!datos.situacion ? 'selected' : ''} disabled>Selecciona</option>
          ${SITUACIONES_FAMILIA.map(op => `<option ${datos.situacion === op ? 'selected' : ''}>${op}</option>`).join('')}
        </select>
      </td>
      <td class="p-1.5 text-center">
        <button type="button" class="btn-eliminar-familiar text-[var(--ink-muted)] hover:text-red-600 text-lg leading-none" title="Eliminar integrante">&times;</button>
      </td>`;
    tr.querySelector('.btn-eliminar-familiar').addEventListener('click', () => tr.remove());
    return tr;
  }

  $('btnAgregarFamiliar').addEventListener('click', () => {
    $('filasComposicionFamiliar').appendChild(crearFilaFamiliar());
  });

  function cargarComposicionFamiliar(lista){
    const tbody = $('filasComposicionFamiliar');
    tbody.innerHTML = '';
    const arr = Array.isArray(lista) ? lista : [];
    if (arr.length === 0) { tbody.appendChild(crearFilaFamiliar()); return; }
    arr.forEach(m => tbody.appendChild(crearFilaFamiliar(m)));
  }

  function leerComposicionFamiliar(){
    return Array.from($('filasComposicionFamiliar').querySelectorAll('tr')).map(tr => ({
      nombre: tr.querySelector('.fam-nombre').value.trim(),
      parentesco: tr.querySelector('.fam-parentesco').value,
      edad: tr.querySelector('.fam-edad').value !== '' ? Number(tr.querySelector('.fam-edad').value) : null,
      ocupacion: tr.querySelector('.fam-ocupacion').value.trim(),
      situacion: tr.querySelector('.fam-situacion').value,
    })).filter(m => m.nombre || m.parentesco || m.ocupacion || m.situacion || m.edad !== null);
  }

  // ---------- Alta / edición ----------
  function resetFichaEstudianteVisual(){
    $('fichaEstudianteExito').classList.add('hidden');
    $('fichaEstudianteExito').classList.remove('success-visible');
    $('fichaEstudiantePanel').classList.remove('hidden', 'ficha-saliendo');
  }

  $('btnNuevoEstudiante').addEventListener('click', () => {
    resetFichaEstudianteVisual();
    $('modalEstudianteTitulo').textContent = 'Nuevo estudiante';
    $('formEstudiante').reset();
    $('campoDni').disabled = false;
    sincronizarCamposViviendaVisual();
    sincronizarCampoLaboralVisual();
    cargarComposicionFamiliar([]);
    abrirModal('modalEstudiante');
  });

  function abrirModalEditar(e){
    resetFichaEstudianteVisual();
    $('modalEstudianteTitulo').textContent = 'Editar estudiante';
    const f = $('formEstudiante');
    f.reset();
    Object.entries(e).forEach(([k, v]) => { if (f[k]) f[k].value = v ?? ''; });
    f.estado_academico.value = e.estado_academico || 'Matriculado';
    f.rendimiento_academico.value = RENDIMIENTO_INFO[e.rendimiento_academico] ? e.rendimiento_academico : '';
    ['condicion_egreso','situacion_laboral','detalle_laboral'].forEach(k => { f[k].value = e[k] ?? ''; });
    $('campoDni').disabled = true; // el DNI es la clave, no editable
    sincronizarCamposViviendaVisual();
    sincronizarCampoLaboralVisual();
    cargarComposicionFamiliar(e.composicion_familiar);
    abrirModal('modalEstudiante');
  }

  const numOrNull = (v) => (v === '' || v === null || v === undefined) ? null : Number(v);
  $('formEstudiante').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const f = ev.target;
    const trabaja = f.trabaja_actualmente.value === 'Sí';
    const payload = {
      dni: f.dni.value.trim(),
      apellidos: f.apellidos.value.trim(),
      nombres: f.nombres.value.trim(),
      fecha_nacimiento: f.fecha_nacimiento.value,
      celular: f.celular.value.trim(),
      correo: f.correo.value.trim(),
      direccion_actual: f.direccion_actual.value.trim(),
      institucion: f.institucion.value,
      carrera: f.carrera.value.trim(),
      ciclo: f.ciclo.value.trim(),
      estado_academico: f.estado_academico.value || 'Matriculado',
      rendimiento_academico: f.rendimiento_academico.value || null,
      observaciones: f.observaciones.value.trim() || null,
      condicion_egreso: f.condicion_egreso.value || null,
      situacion_laboral: f.situacion_laboral.value || null,
      detalle_laboral: f.detalle_laboral.value.trim() || null,
      ...(ESTADOS_BAJA.includes(f.estado_academico.value) ? { estado_actual: '-' } : {}),
      telefono_emergencia: f.telefono_emergencia.value.trim(),
      modalidad_vivienda: f.modalidad_vivienda.value,
      monto_alquiler: f.modalidad_vivienda.value === 'Casa o cuarto alquilado' && f.monto_alquiler.value !== ''
        ? Number(f.monto_alquiler.value) : null,
      paga_alquiler_familiar: f.modalidad_vivienda.value === 'Vivienda de algún familiar'
        ? f.paga_alquiler_familiar.value : null,
      monto_alquiler_familiar: f.modalidad_vivienda.value === 'Vivienda de algún familiar'
        && f.paga_alquiler_familiar.value === 'Sí' && f.monto_alquiler_familiar.value !== ''
        ? Number(f.monto_alquiler_familiar.value) : null,
      convivencia: f.convivencia.value,
      convivencia_detalle: f.convivencia.value === 'Con alguien' ? f.convivencia_detalle.value.trim() : null,
      composicion_familiar: leerComposicionFamiliar(),
      trabaja_actualmente: f.trabaja_actualmente.value,
      lugar_trabajo: trabaja ? f.lugar_trabajo.value.trim() : null,
      ocupacion_actual: trabaja ? f.ocupacion_actual.value.trim() : null,
      horario_trabajo: trabaja ? f.horario_trabajo.value.trim() : null,
      antecedentes_psicologicos: f.antecedentes_psicologicos.value.trim(),
      diagnostico_psiquiatrico: f.diagnostico_psiquiatrico.value.trim(),
    };

    const btn = $('btnGuardarEstudiante');
    btn.disabled = true;

    const esNuevo = !estudiantes.some(x => String(x.dni) === String(payload.dni));
    const { data: guardado, error: errUp } = await supabaseClient.from('estudiantes').upsert(payload, { onConflict: 'dni' }).select('dni');
    const error = errUp || ((guardado && guardado.length) ? null : { message: 'Supabase no guardó el registro (revisa las políticas RLS del script SQL integral).' });

    btn.disabled = false;

    if (error) { alert('Error al guardar: ' + error.message); return; }

    if (esNuevo) marcarNuevo(payload.dni);
    await cargarEstudiantes();

    // La ficha se desvanece y da paso a la confirmación de éxito
    const ficha = $('fichaEstudiantePanel');

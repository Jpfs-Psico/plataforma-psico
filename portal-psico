  async function eliminarDocumento(d){
    if (!confirm(`¿Eliminar el documento "${d.titulo || d.nombre_archivo}"?`)) return;
    const { data, error } = await supabaseClient.from('documentos_estudiante').delete().eq('id', d.id).select('id');
    if (error) { alert('No se pudo eliminar el documento: ' + error.message); return; }
    if (!data || !data.length) { alert('No se eliminó ningún documento: revisa las políticas (RLS) del script SQL integral.'); return; }
    await cargarDocumentos();
  }

  // --- Visor flotante ---
  function limpiarVisorPdf(){
    $('pdfPreview').src = 'about:blank';
    if (pdfUrlActual) { URL.revokeObjectURL(pdfUrlActual); pdfUrlActual = null; }
  }
  function cerrarVisorPdf(){
    $('modalPdf').classList.add('hidden');
    limpiarVisorPdf();
  }
  async function abrirVisorPdf(d){
    $('pdfTitulo').textContent = d.titulo || d.nombre_archivo;
    limpiarVisorPdf();
    abrirModal('modalPdf');
    const { data, error } = await supabaseClient.from('documentos_estudiante')
      .select('archivo_base64,nombre_archivo').eq('id', d.id).single();
    if (error || !data || !data.archivo_base64) {
      cerrarVisorPdf();
      alert('No se pudo cargar el documento.');
      return;
    }
    pdfUrlActual = URL.createObjectURL(dataUrlToBlob(data.archivo_base64));
    $('pdfPreview').src = pdfUrlActual;
    const link = $('pdfDescargar');
    link.href = pdfUrlActual;
    link.download = data.nombre_archivo || 'documento.pdf';
  }
  $('btnCerrarPdf').addEventListener('click', cerrarVisorPdf);
  $('modalPdf').addEventListener('click', (ev) => { if (ev.target === $('modalPdf')) cerrarVisorPdf(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' || e.key === 'Esc') limpiarVisorPdf(); });

  // --- Adjuntar ---
  function abrirAdjuntar(tipo){
    if (!estudianteActivo) return;
    $('formAdjuntar').reset();
    $('adjuntarError').classList.add('hidden');
    $('adjuntarEstudiante').textContent = `Estudiante: ${estudianteActivo.nombres} ${estudianteActivo.apellidos}`;
    $('adjuntarTipo').value = tipo || (!$('tabInformes').classList.contains('hidden') ? 'informe' : 'sesion');
    abrirModal('modalAdjuntar');
  }
  $('btnAdjuntarSesion').addEventListener('click', () => abrirAdjuntar('sesion'));
  $('btnAdjuntarInforme').addEventListener('click', () => abrirAdjuntar('informe'));
  $('btnAdjuntarDesdeSesion').addEventListener('click', () => abrirAdjuntar('sesion'));
  $('btnAdjuntarDesdeInforme').addEventListener('click', () => abrirAdjuntar('informe'));

  $('formAdjuntar').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const err = $('adjuntarError');
    const mostrarError = (m) => { err.textContent = m; err.classList.remove('hidden'); };
    err.classList.add('hidden');

    const file = $('adjuntarArchivo').files[0];
    if (!file) return mostrarError('Selecciona un archivo PDF.');
    if (!(file.type === 'application/pdf' || /\.pdf$/i.test(file.name))) return mostrarError('El archivo debe ser un PDF.');
    if (file.size > DOC_MAX_BYTES) return mostrarError(`El archivo pesa ${fmtTamano(file.size)}. El máximo permitido es 5 MB.`);

    const btn = $('btnGuardarAdjunto');
    const original = btn.textContent;
    btn.disabled = true; btn.textContent = 'Guardando…';
    try {
      const dataUrl = await leerArchivoComoDataURL(file);
      const tipo = $('adjuntarTipo').value;
      const { data, error } = await supabaseClient.from('documentos_estudiante').insert({
        dni_estudiante: estudianteActivo.dni,
        tipo,
        titulo: $('adjuntarTitulo').value.trim() || null,
        nombre_archivo: file.name,
        tamano: file.size,
        archivo_base64: dataUrl,
      }).select('id');
      if (error) throw error;
      if (!data || !data.length) throw new Error('Supabase no guardó el documento (revisa las políticas RLS del script SQL integral).');
      cerrarModales();
      ocultarEditores();
      cambiarSubtab(tipo === 'informe' ? 'informes' : 'sesiones');
      await cargarDocumentos();
    } catch (e) {
      const falta = /documentos_estudiante|schema cache|does not exist/i.test(e.message || '');
      mostrarError('No se pudo guardar el documento: ' + (e.message || e) +
        (falta ? ' — Ejecuta primero el SQL de supabase_cambios.sql.' : ''));
    } finally {
      btn.disabled = false; btn.textContent = original;
    }
  });

  // ---------- Pruebas psicológicas / corrección automática ----------
  async function cargarPruebasResultado(){
    if (!$('listaPruebasResultados')) return; // la pestaña de pruebas ya no existe en el perfil
    const { data } = await supabaseClient.from('resultados_pruebas').select('*')
      .eq('dni_estudiante', estudianteActivo.dni).order('fecha_aplicacion', { ascending: false });
    const cont = $('listaPruebasResultados'); cont.innerHTML = '';
    $('pruebasVacio').classList.toggle('hidden', (data || []).length > 0);
    (data || []).forEach(r => {
      const div = document.createElement('div');
      div.className = 'card rounded-xl p-4 flex items-center justify-between gap-4';
      const estadoColor = r.estado === 'corregido' ? 'bg-[var(--success-soft)] text-[var(--success)]' : 'bg-amber-50 text-amber-700';
      div.innerHTML = `
        <div>
          <p class="font-semibold text-sm">${r.nombre_prueba}</p>
          <p class="text-xs text-[var(--ink-muted)] mt-0.5">Aplicada el ${fmtFecha(r.fecha_aplicacion)}</p>
        </div>
        <div class="flex items-center gap-2 whitespace-nowrap">
          <span class="badge ${estadoColor}">${r.estado}</span>
          ${r.estado !== 'corregido'
            ? `<button class="btn-primary rounded-xl px-3 py-1.5 text-xs font-semibold btn-corregir">Generar corrección</button>`
            : `<button class="btn-ghost rounded-xl px-3 py-1.5 text-xs font-semibold btn-preview">Vista previa</button>`
          }
        </div>`;
      if (r.estado !== 'corregido') {
        div.querySelector('.btn-corregir').addEventListener('click', (e) => corregirPrueba(r, e.target));
      } else {
        div.querySelector('.btn-preview').addEventListener('click', () => previsualizarPrueba(r));
      }
      cont.appendChild(div);
    });
  }

  async function corregirPrueba(resultado, btn){
    btn.disabled = true; btn.textContent = 'Procesando…';

    let baremo = [];
    if (resultado.id_prueba) {
      const { data: prueba } = await supabaseClient.from('pruebas_catalogo').select('baremo_json').eq('id', resultado.id_prueba).single();
      baremo = prueba?.baremo_json || [];
    }

    const puntaje = (resultado.respuestas_json || []).reduce((acc, r) => acc + (Number(r.valor) || 0), 0);
    let interpretacion = 'Sin baremo configurado para esta prueba.';
    const rango = baremo.find(b => puntaje >= b.min && puntaje <= b.max);
    if (rango) interpretacion = rango.interpretacion;

    const { error } = await supabaseClient.from('resultados_pruebas').update({
      puntaje_obtenido: puntaje,
      interpretacion_automatica: interpretacion,
      estado: 'corregido'
    }).eq('id', resultado.id);

    if (error) { alert('Error al corregir: ' + error.message); btn.disabled = false; btn.textContent = 'Generar corrección'; return; }
    cargarPruebasResultado();
  }

  function previsualizarPrueba(r){

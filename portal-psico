  // ---------- DASHBOARD 3 ----------
  const D3_POR_PAG = 10;
  let d3Pag = 1, d3Todas = false, d3Lista = [], d3Edit = null /* null | 'nuevo' | id */, d3Vis = { base:0, i:'' };
  const fmtF = (f) => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(f || ''); return m ? `${m[3]}/${m[2]}/${m[1]}` : '—'; };
  const COL_TIPO = { [TIPO_VISITA]: COL.azul, [TIPO_TALLER]: COL.mor, [TIPO_FAMILIAR]: COL.verde };
  const TIPOS_MATRIZ = ['Visita Institucional', 'Taller / Escuela de Padres', 'Intervención Familiar'];

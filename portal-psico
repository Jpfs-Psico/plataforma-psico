    abrirModal('modalPreview');
  }

  function filaPreview(label, valor){
    return `<div class="mb-4">
      <p class="text-xs uppercase tracking-widest text-[var(--ink-muted)] font-semibold mb-1">${label}</p>
      <p class="text-sm whitespace-pre-line">${valor && valor.trim() ? valor : '—'}</p>

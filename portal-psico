  const canonSede = (t) => { const x = sinAcentos(String(t || '').trim()); return SEDES_MATRIZ.find(n => sinAcentos(n) === x) || String(t || '').trim(); };
  // Observaciones de un registro de campo (pestaña Intervención Comunitaria): fecha puntual + participantes + becario + observaciones
  function observacionCampo(x){

  // Gráfico de barras: Visitas Institucionales (contador del KPI = conteo automático + ajuste manual) + filas de la matriz por tipo
  // + registros de campo de talleres / intervenciones familiares. Se recalcula con cada cambio del contador, de la matriz o del filtro.
  const CATS_INT = ['Visitas Institucionales', 'Talleres / Escuela de Padres', 'Intervención Familiar'];
  const COL_INT = [COL.azul, COL.mor, COL.verde];
  const filasMx = (i, tipo) => D.mx.filter(r => (!i || canonSede(r.institucion) === i) && r.tipo_intervencion === tipo).length;
  const visitasMatriz = (i) => filasMx(i, 'Visita Institucional');
  function conteoIntervenciones(i){
    const C = D.int.filter(x => !i || instDeIntervencion(x) === i);
    const visitas = Math.max(0, C.filter(x => x.tipo_intervencion === TIPO_VISITA).length + visitasMatriz(i) + (i ? (D.aj[claveVis(i)] || 0) : ajusteTotalVis()));   // = valor de la tarjeta de visitas
    const talleres = C.filter(x => x.tipo_intervencion === TIPO_TALLER).length + filasMx(i, 'Taller / Escuela de Padres');
    const familiares = C.filter(x => x.tipo_intervencion === TIPO_FAMILIAR).length + filasMx(i, 'Intervención Familiar');
    return [visitas, talleres, familiares];
  }
  // --- Visitas por mes: SOLO se lee el texto del campo "Observaciones" de cada registro de visita (matriz + registros de campo).
  // De cada observación se extrae el mes escrito y la cantidad de visitas escrita en el texto; se suma por mes. No se usa ningún otro campo ni el contador manual.
  const COL_MES = { 1:'#64748B', 2:COL.teal, 3:COL.ambar, 4:'#BE5A8A', 5:'#6FA35C', 6:'#0F766E', 7:'#B7791F', 8:COL.naranja, 9:COL.azulc, 10:COL.rojo, 11:'#8B5E3C', 12:'#475569' };
  const MES_NOMBRES = MESES_LARGO.map(m => sinAcentos(m)).map(m => m === 'septiembre' ? 'se[p]?tiembre' : m);
  const RX_MES = MES_NOMBRES.map((m, k) => [k + 1, new RegExp('(^|[^a-z])' + m + '([^a-z]|$)')]);
  const RX_MES_TXT = '(?:' + MES_NOMBRES.join('|') + ')';
  const NUM_PALABRA = { un:1, una:1, uno:1, dos:2, tres:3, cuatro:4, cinco:5, seis:6, siete:7, ocho:8, nueve:9, diez:10, once:11, doce:12, trece:13, catorce:14, quince:15, dieciseis:16, diecisiete:17, dieciocho:18, diecinueve:19, veinte:20 };
  const RX_PAL = Object.keys(NUM_PALABRA).sort((a, b) => b.length - a.length).join('|');
  function mesDeTexto(t){   // t ya sin acentos y en minúsculas; si menciona varios meses, gana el primero que aparece
    let mejor = 0, pos = Infinity;
    RX_MES.forEach(([n, rx]) => { const m = rx.exec(t); if (m && m.index < pos) { pos = m.index; mejor = n; } });
    if (mejor) return mejor;
    const f = /(^|[^0-9])\d{1,2}[\/\-.](0?[1-9]|1[0-2])[\/\-.]\d{2,4}([^0-9]|$)/.exec(t);   // respaldo: fecha tipo 18/10/2026
    return f ? Number(f[2]) : 0;
  }
  function cantidadDeTexto(t){   // cantidad de visitas escrita en el texto: "19 visitas", "visitas: 19", "cinco visitas" o, si no, el único número suelto
    const l = t.replace(/\d{1,2}[\/\-.]\d{1,2}[\/\-.]\d{2,4}/g, ' ').replace(new RegExp('\\d{1,2}\\s+de\\s+' + RX_MES_TXT, 'g'), ' ').replace(/\b20\d\d\b/g, ' ');
    let m = /(\d+)\s*(?:visitas?|vis\.?)(?![a-z])/.exec(l) || /visitas?(?:\s+realizadas?)?\s*[:=\-]?\s*(\d+)/.exec(l);
    if (m) return Number(m[1]);
    m = new RegExp('(^|[^a-z])(' + RX_PAL + ')\\s+visitas?(?![a-z])').exec(l); if (m) return NUM_PALABRA[m[2]];
    const sueltos = l.match(/\d+/g); return sueltos ? Number(sueltos[0]) : null;
  }
  // Una observación puede traer varios meses separados por punto, punto y coma o salto de línea ("Agosto: 5 visitas. Septiembre: 7 visitas")
  function visitasDeObservacion(txt){
    const t = sinAcentos(txt), res = [];
    t.split(/;|\n|\.\s/).forEach(seg => { const m = mesDeTexto(seg), c = cantidadDeTexto(seg); if (m && c != null) res.push([m, c]); });
    if (!res.length) { const m = mesDeTexto(t), c = cantidadDeTexto(t); if (m && c != null) res.push([m, c]); }
    return res;
  }
  function visitasPorMes(i){
    const obs = [...D.mx.filter(r => (!i || canonSede(r.institucion) === i) && r.tipo_intervencion === 'Visita Institucional').map(r => (r.observaciones != null ? r.observaciones : r.acuerdos) || ''),
      ...D.int.filter(x => x.tipo_intervencion === TIPO_VISITA && (!i || instDeIntervencion(x) === i)).map(x => x.observaciones || '')];
    const porMes = {}; let omitidos = 0;

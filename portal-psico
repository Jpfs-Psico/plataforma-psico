  // DESCARGAR BASE DE DATOS — PDF directo (jsPDF + autoTable), sin ventana previa
  // ============================================================
  // Una sola tabla consolidada, centrada, con 9 columnas fijas. Anchos en mm: suman 281, el ancho útil de A4 horizontal (297 − 2×8).
  function generarPDFBaseDeDatos(){
    if (!estudiantes.length) { alert('No hay estudiantes registrados para descargar.'); return; }
    if (!(window.jspdf && window.jspdf.jsPDF)) { alert('No se cargó la librería de PDF. Revisa tu conexión a internet y recarga la página.'); return; }

    const doc = new window.jspdf.jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
    const pageW = doc.internal.pageSize.getWidth(), pageH = doc.internal.pageSize.getHeight();
    const columnas = ['Apellidos y Nombres', 'DNI', 'Institución', 'Carrera', 'Ciclo', 'Estado Académico', 'Rendimiento Académico', 'Situación Laboral', 'Estado'];
    const anchos = [50, 20, 26, 44, 13, 30, 30, 44, 24];
    const tablaW = anchos.reduce((a, b) => a + b, 0);
    const margen = (pageW - tablaW) / 2;   // tabla centrada en la hoja
    const v = (x) => { const t = (x ?? '').toString().trim(); return t || '-'; };
    const estadoTxt = (x) => { const c = normalizarEstado(x); return c === '-' ? '-' : ESTADOS_INFO[c].label; };

    const filas = estudiantes.slice()
      .sort((a, b) => (a.institucion || '').localeCompare(b.institucion || '', 'es') || `${a.apellidos} ${a.nombres}`.localeCompare(`${b.apellidos} ${b.nombres}`, 'es'))
      .map(e => [`${e.apellidos || ''}, ${e.nombres || ''}`.trim(), v(e.dni), v(e.institucion), v(e.carrera).replace(/\s*\/\s*/g, ' / '), v(e.ciclo),
                 v(e.estado_academico), v(e.rendimiento_academico), v(e.situacion_laboral), estadoTxt(e.estado_actual)]);

    const fecha = new Date().toLocaleDateString('es-PE', { day:'2-digit', month:'long', year:'numeric' });
    doc.setFont('helvetica', 'bold'); doc.setFontSize(15); doc.setTextColor(27, 58, 87);
    doc.text('Base de Datos de Becarios', pageW / 2, 14, { align: 'center' });
    doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(110, 120, 128);
    doc.text(`Portal Sinapsis · Total de becarios: ${filas.length} · Generado el ${fecha}`, pageW / 2, 20, { align: 'center' });

    doc.autoTable({
      startY: 25, margin: { left: margen, right: margen, top: 14, bottom: 14 }, tableWidth: tablaW,
      head: [columnas], body: filas,
      styles: { font: 'helvetica', fontSize: 7.5, cellPadding: 1.8, overflow: 'linebreak', valign: 'middle', halign: 'center', lineColor: [214, 219, 213], lineWidth: 0.1, textColor: 35 },
      headStyles: { fillColor: [27, 58, 87], textColor: 255, fontStyle: 'bold', halign: 'center', fontSize: 7.5 },
      alternateRowStyles: { fillColor: [246, 247, 245] },
      columnStyles: Object.fromEntries(anchos.map((w, i) => [i, { cellWidth: w, halign: 'center', ...(i === 3 ? { fontSize: 7 } : {}) }])),
      rowPageBreak: 'avoid',
    });

    const n = doc.internal.getNumberOfPages();
    for (let i = 1; i <= n; i++) {
      doc.setPage(i); doc.setFont('helvetica', 'normal'); doc.setFontSize(8); doc.setTextColor(130, 138, 145);
      doc.text(`Página ${i} de ${n}`, pageW / 2, pageH - 7, { align: 'center' });
    }
    doc.save(`Base_de_Datos_Sinapsis_${new Date().toISOString().slice(0, 10)}.pdf`);
  }


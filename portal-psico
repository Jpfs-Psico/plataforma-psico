  const claveVis = (i) => PREF_VIS + (i || 'GENERAL');
  const ajusteTotalVis = () => Object.entries(D.aj).filter(([k]) => k.startsWith(PREF_VIS)).reduce((a, [, v]) => a + v, 0);
  // KPI "Número total de visitas institucionales": solo lectura. Es la suma de las visitas de todos los meses de la barra apilada

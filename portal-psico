  .perfil-dato dd{ margin:.2rem 0 0; font-size:.9375rem; font-weight:600; overflow-wrap:anywhere; }
  .perfil-card-title{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:700; font-size:1.0625rem; letter-spacing:-.01em; }
  #seccionDashboards .perfil-card-title, .pdf-reporte .perfil-card-title{ text-transform:uppercase; letter-spacing:.01em; }   /* títulos de gráficos y tablas del Dashboard (pantalla y PDF) en mayúsculas sostenidas */
  .modulo-titulo{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; font-size:1.3rem; letter-spacing:-.015em; line-height:1.2; color:var(--ink); margin:0; }   /* título de módulo del Dashboard (mismo formato en los 3 módulos, pantalla y PDF) */
  .perfil-sub{ font-size:.8125rem; color:var(--ink-muted); line-height:1.45; }

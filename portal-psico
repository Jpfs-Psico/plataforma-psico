  .pdf-reporte .perfil-sub{ font-size:9.5px !important; color:#5B6B75; margin:0 0 6px !important; }
  .pdf-reporte .font-display{ font-family:'Plus Jakarta Sans',sans-serif; }
  .pdf-reporte .text-3xl{ font-size:20px !important; line-height:1.1 !important; margin-top:2px !important; }

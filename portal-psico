  const tablaFaltante = (e) => /relation|does not exist|schema cache|could not find/i.test(e && e.message || '');

  async function cargarBecarios(){
    const { data } = await supabaseClient.from('estudiantes').select('dni,apellidos,nombres').order('apellidos');
    const s = $('comAlcance'), cur = s.value;
    s.innerHTML = `<option value="">${GENERAL}</option>` + (data || []).map(b => `<option value="${escHtml(b.dni)}">${escHtml(b.apellidos + ', ' + b.nombres)}</option>`).join('');
    s.value = cur;
  }
  function pintarTabla(){
    $('comVacio').classList.toggle('hidden', datos.length > 0);
    $('comTabla').innerHTML = datos.map(x => {
      const b = BADGE[x.tipo_intervencion] || ['var(--surface-alt)','var(--ink)','•'];
      return `<tr><td class="px-4 py-3 whitespace-nowrap">${fmtFecha(x.fecha)}</td>
        <td class="px-4 py-3"><span class="inline-block rounded-full px-2.5 py-0.5 text-[11px] font-bold whitespace-nowrap" style="background:${b[0]};color:${b[1]}">${b[2]} ${escHtml(x.tipo_intervencion)}</span></td>
        <td class="px-4 py-3" style="min-width:150px">${escHtml(dirigido(x))}</td>
        <td class="px-4 py-3 font-semibold" style="min-width:150px">${escHtml(x.institucion_grupo)}</td>
        <td class="px-4 py-3" style="min-width:200px">${escHtml(x.tema)}</td>
        <td class="px-4 py-3 text-center">${x.num_asistentes ?? '—'}</td>
        <td class="px-4 py-3 text-xs" style="min-width:180px">${escHtml((x.observaciones || '').trim() || '—')}</td>
        <td class="px-4 py-3 text-center whitespace-nowrap"><button class="btn-ghost rounded-lg px-3 py-1.5 text-xs font-semibold" data-com-edit="${x.id}">Editar</button>
          <button class="btn-danger rounded-lg px-3 py-1.5 text-xs font-semibold" data-com-del="${x.id}">Eliminar</button></td></tr>`; }).join('');
  }
  async function cargar(){
    const { data, error } = await supabaseClient.from(TABLA).select('*').order('fecha', { ascending:false }).order('id', { ascending:false });
    if (error) { datos = []; mostrarAviso(tablaFaltante(error) ? 'Falta la tabla "intervenciones_comunitarias" en Supabase. Ejecuta supabase_comunidad.sql.' : 'No se pudieron cargar las intervenciones: ' + error.message); }
    else { datos = data || []; mostrarAviso(''); }
    pintarTabla();
  }
  async function abrirForm(reg){
    const f = $('comForm'); editandoId = reg ? reg.id : null; f.reset();
    await cargarBecarios();
    f.tipo_intervencion.value = reg ? reg.tipo_intervencion : '';
    f.alcance.value = reg ? (reg.estudiante_dni || '') : '';
    f.institucion_grupo.value = reg ? reg.institucion_grupo : '';
    f.tema.value = reg ? reg.tema : '';
    f.fecha.value = reg ? (reg.fecha || '') : hoyLocal();
    f.num_asistentes.value = reg && reg.num_asistentes != null ? reg.num_asistentes : '';
    f.observaciones.value = reg ? (reg.observaciones || '') : '';
    $('comFormTitulo').textContent = reg ? 'Editar intervención' : 'Nueva intervención';
    $('comBtnGuardar').textContent = reg ? 'Guardar cambios' : 'Guardar intervención';
    mostrarMsg(''); $('comFormCard').classList.remove('hidden');
    $('comFormCard').scrollIntoView({ behavior:'smooth', block:'start' });
  }
  function cerrarForm(){ editandoId = null; $('comForm').reset(); $('comFormCard').classList.add('hidden'); mostrarMsg(''); }

  $('comBtnNueva').addEventListener('click', () => abrirForm(null));
  $('comBtnCancelar').addEventListener('click', cerrarForm);
  $('navComunidad').addEventListener('click', () => { cambiarSeccionPrincipal('comunidad'); cargar(); });

  $('comForm').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const f = ev.target, btn = $('comBtnGuardar'), dni = f.alcance.value;
    const payload = {
      tipo_intervencion: f.tipo_intervencion.value,
      alcance: dni ? 'Becario' : GENERAL,
      estudiante_dni: dni || null,
      becario_nombre: dni ? f.alcance.selectedOptions[0].text : null,
      institucion_grupo: f.institucion_grupo.value.trim(),
      tema: f.tema.value.trim(),
      fecha: f.fecha.value || null,
      num_asistentes: f.num_asistentes.value !== '' ? Math.max(0, Math.floor(Number(f.num_asistentes.value))) : null,
      observaciones: f.observaciones.value.trim() || null };
    if (!payload.tipo_intervencion || !payload.institucion_grupo || !payload.tema || !payload.fecha) { mostrarMsg('Completa tipo, institución / lugar / grupo, tema y fecha.', true); return; }
    btn.disabled = true; mostrarMsg('Guardando…');
    const q = editandoId ? supabaseClient.from(TABLA).update(payload).eq('id', editandoId).select('id') : supabaseClient.from(TABLA).insert(payload).select('id');
    const { data, error } = await q; btn.disabled = false;
    if (error) { mostrarMsg('No se pudo guardar: ' + error.message + (tablaFaltante(error) ? ' — ejecuta primero supabase_comunidad.sql.' : ''), true); return; }
    if (!data || !data.length) { mostrarMsg('Supabase no aceptó el cambio. Revisa las políticas (RLS) del script SQL.', true); return; }
    cerrarForm(); await cargar();
  });
  $('comTabla').addEventListener('click', async (ev) => {
    const ed = ev.target.closest('[data-com-edit]'), del = ev.target.closest('[data-com-del]');
    if (ed) { const reg = datos.find(x => String(x.id) === ed.dataset.comEdit); if (reg) abrirForm(reg); return; }
    if (!del || !confirm('¿Eliminar esta intervención? También dejará de contarse en el Dashboard.')) return;
    const { data, error } = await supabaseClient.from(TABLA).delete().eq('id', del.dataset.comDel).select('id');
    if (error) { alert('No se pudo eliminar: ' + error.message); return; }
    if (!data || !data.length) { alert('No se eliminó ningún registro: revisa las políticas (RLS).'); return; }
    await cargar();
  });
})();
</script>

<script>
// ============================================================================
// MÓDULO DE DASHBOARDS EJECUTIVOS (Académico · Psicológico · Comunitario)
// ============================================================================
(function(){
  const COL = { azul:'#1B3A57', verde:'#2F7D5B', ambar:'#D9A441', rojo:'#C0504D', naranja:'#E8871E', azulc:'#2F80C9', teal:'#3A8FA3', gris:'#9AA8B0', mor:'#7A68A8' };
  const ACTIVOS = ['Matriculado','Matrícula pendiente','Cursando ciclo','Curso pendiente / Subsanación'];
  const BAJAS   = ['Retiro voluntario','Deserción','Abandono Definitivo','Retiro Formal','Renuncia Voluntaria Inicial'];   // Retiro Voluntario / Deserción
  const esSuspension = (e) => /suspens|suspendid/i.test(e.estado_academico || '');   // Suspensión Temporal
  const esPausa = (e) => /pausa/i.test(e.estado_academico || '');   // Pausa Académica (gestación / licencia médica: mantiene vacante y matrícula)
  const ESTADOS_MOTIVO = [...BAJAS,'Suspensión Temporal','Suspendido','Pausa Académica'];
  const INSTITUCIONES = ['SENATI','UTP','USS','Valle Grande','CETEMIN'];
  const MESES = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

  let D = { est:[], int:[], mx:[], aj:{}, mxErr:false, ajErr:false, notas:[], notasErr:false, notasRiesgo:[], notasRiesgoErr:'' };
  let charts = {};
  let panelActivo = 1;

  const esc = (s) => escHtml(s);
  const pct = (a,b) => b ? Math.round((a/b)*1000)/10 : 0;
  const fmtPct = (a,b) => b ? pct(a,b).toLocaleString('es-PE',{minimumFractionDigits:1,maximumFractionDigits:1}) + '%' : '—';
  const contar = (arr, fn) => arr.reduce((m,x)=>{ const k=fn(x); m[k]=(m[k]||0)+1; return m; },{});
  const esEgresado = (e) => e.estado_academico === 'Egresado';
  // Cohorte de egreso: los egresados + los becarios que finalizaron su plan de estudios pero tienen asignaturas por subsanar
  // (estado académico "Curso pendiente / Subsanación"). Estos últimos se mantienen como "activos" en el resto de indicadores.
  const esSubsanacion = (e) => e.estado_academico === 'Curso pendiente / Subsanación';
  const esCohorteEgreso = (e) => esEgresado(e) || esSubsanacion(e);
  const SIT_SUBSANACION = 'Continuidad Académica / Subsanación', SIT_REORIENTACION = 'Continuidad Académica / Reorientación';
  const textoLibre = (e) => [e.situacion_laboral, e.detalle_laboral, e.observaciones].filter(Boolean).join(' ');
  const esReorientacion = (e) => e.situacion_laboral === SIT_REORIENTACION || /reorient|nueva carrera|otra carrera|no\s+(?:desea\s+)?subsan|desist/i.test(textoLibre(e));
  // Condición con la que cada becario de la cohorte entra al gráfico circular
  function condicionEgreso(e){
    if (esSubsanacion(e)) return esReorientacion(e) ? SIT_REORIENTACION : SIT_SUBSANACION;
    return (e.situacion_laboral || '').trim() || 'Sin registrar';
  }
  // Observación mostrada en la tabla: EXACTAMENTE la nota manual guardada en el perfil del becario (columna "observaciones"), sin textos automáticos ni concatenaciones
  const observacionEgreso = (e) => (e.observaciones || '').trim() || '-';
  const nombreDe = (e) => `${e.apellidos||''}, ${e.nombres||''}`.trim();
  // Orden jerárquico fijo de instituciones para las tablas del Dashboard y nombre completo para mostrar en sus celdas
  const INST_JERARQUIA = ['USS','UTP','SENATI','CETEMIN','Valle Grande'];
  const INST_NOMBRE_COMPLETO = { 'USS':'Universidad Señor de Sipán', 'UTP':'Universidad Tecnológica del Perú', 'SENATI':'SENATI', 'CETEMIN':'CETEMIN', 'Valle Grande':'Valle Grande' };
  const nombreInstitucion = (v) => { const t = String(v || '').trim(); if (!t) return ''; const c = canonInst(t); return INST_NOMBRE_COMPLETO[c] || c; };
  const rangoInst = (e) => { const i = INST_JERARQUIA.indexOf(canonInst(e.institucion)); return i < 0 ? INST_JERARQUIA.length : i; };
  // Primero por institución (jerarquía fija) y, dentro de cada una, alfabético por apellidos y nombres
  const porInstitucionYNombre = (a, b) => (rangoInst(a) - rangoInst(b)) || nombreDe(a).localeCompare(nombreDe(b), 'es', { sensitivity:'base' });
  const num = (v) => (v===null||v===undefined||v==='') ? null : Number(v);
  const esBaja = (e) => BAJAS.includes(e.estado_academico);
  const esActivo = (e) => ACTIVOS.includes(e.estado_academico);

  function dibujar(id, config){
    if (charts[id]) charts[id].destroy();
    const cv = $(id); if (!cv) return;
    charts[id] = new Chart(cv.getContext('2d'), config);
  }
  // Datalabels solo se muestra en el gráfico que lo pida expresamente (la dona del Dashboard 2)
  try { Chart.defaults.plugins.datalabels = Object.assign({}, Chart.defaults.plugins.datalabels, { display:false }); } catch (err) { /* plugin no cargado */ }
  // Texto central de la dona: total acumulado de casos detectados
  const centroDonaPlugin = {
    id: 'centroDona',
    afterDraw(chart, args, opts){
      if (!opts || opts.total === undefined) return;
      const a = chart.chartArea, ctx = chart.ctx, x = (a.left + a.right) / 2, y = (a.top + a.bottom) / 2;
      ctx.save(); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillStyle = '#16212B'; ctx.font = '800 34px "Plus Jakarta Sans", sans-serif'; ctx.fillText(String(opts.total), x, y - 10);
      ctx.fillStyle = '#5B6B75'; ctx.font = '600 12px Inter, sans-serif'; ctx.fillText('casos detectados', x, y + 18);
      ctx.restore();
    }
  };
  // Si la dona ya existe se actualizan solo los datos (animado); si no, se crea
  function dibujarDona(config){
    const ch = charts['chEvolucion'];
    if (ch && ch.config.type === 'doughnut' && ch.canvas && document.body.contains(ch.canvas)) {
      ch.data.datasets[0].data = config.data.datasets[0].data;
      ch.options.plugins.centroDona.total = config.options.plugins.centroDona.total;
      ch.options.plugins.tooltip = config.options.plugins.tooltip;
      ch.options.plugins.datalabels = config.options.plugins.datalabels;
      ch.update();
    } else dibujar('chEvolucion', config);
  }
  // Casos por Factor Principal (Nivel 1) y Estado del Caso. Cada becario cuenta UNA vez, según su estado actual:
  //  Todo caso con factor registrado cuenta como detectado (acumulado = total). aten (amarillo) = En Atención / Soporte Activo · evol (azul) = Evolución Favorable · res (verde) = Caso Resuelto / Alta
  function casosPorFactor(L, factores, alias){
    const norm = (v) => (alias && alias[v]) || v;
    const aten = factores.map(() => 0), evol = factores.map(() => 0), res = factores.map(() => 0), aband = factores.map(() => 0);
    L.forEach(e => {
      const i = factores.indexOf(norm(e.factor_riesgo_principal)); if (i < 0) return;
      const est = scNormEstado(e.estado_caso);   // antiguos 'detectado' / 'proceso' / 'activo' se leen como 'atencion'
      if (est === 'evolucion') evol[i]++; else if (est === 'resuelto') res[i]++; else if (est === 'abandono') aband[i]++; else aten[i]++;
    });
    const sum = (a) => a.reduce((x, y) => x + y, 0);
    const sinClasificar = L.filter(e => e.factor_riesgo_principal && !factores.includes(norm(e.factor_riesgo_principal))).length;
    const totales = factores.map((_, i) => aten[i] + evol[i] + res[i] + aband[i]);
    return { aten, evol, res, aband, totales, totA: sum(aten), totE: sum(evol), totR: sum(res), totB: sum(aband), total: sum(totales), sinClasificar };
  }
  // Parte una etiqueta larga en varias líneas para los ejes del radar
  function partirEtiqueta(t, max){
    const out = []; let l = '';
    String(t).split(' ').forEach(w => { if (l && (l + ' ' + w).length > max) { out.push(l); l = w; } else l = l ? l + ' ' + w : w; });
    if (l) out.push(l); return out;
  }
  // Matriz global de gestión con instituciones (Dashboard 3)
  // Fuentes: pestaña Comunidad (intervenciones_comunitarias) + registros previos (gestion_institucional, hitos_coordinacion, talleres_comunitarios).
  // Todo registro se asigna a una institución conocida si su nombre la contiene; si no (grupos, becarios), va a la fila "Otros".
  const TIPO_VISITA = 'Visita Institucional', TIPO_TALLER = 'Taller Grupal / Escuela de Padres', TIPO_FAMILIAR = 'Intervención Familiar por Hogar';
  const OTROS = 'Otros (grupos / becarios)';
  const sinAcentos = (s) => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const claveInst = (txt) => {
    const k = sinAcentos(txt).trim(); if (!k) return OTROS;
    const exacta = INSTITUCIONES.find(n => sinAcentos(n) === k); if (exacta) return exacta;
    return INSTITUCIONES.find(n => new RegExp('(^|[^a-z0-9])' + sinAcentos(n).replace(/\s+/g, '\\s+') + '([^a-z0-9]|$)').test(k)) || OTROS;
  };
  function kpi(titulo, valor, detalle, color){
    return `<div class="card rounded-[18px] p-5"><p class="text-xs font-bold uppercase tracking-[.08em]" style="color:var(--ink-muted)">${titulo}</p>
      <p class="font-display text-3xl font-extrabold mt-1" style="color:${color||'var(--ink)'}">${valor}</p>
      <p class="text-xs mt-1" style="color:var(--ink-muted)">${detalle||''}</p></div>`;
  }
  const vacio = (txt) => `<div class="empty-state"><strong>Sin datos</strong>${txt}</div>`;

  // ---------- Carga y filtros ----------
  async function cargarDatos(){
    const q = (t) => supabaseClient.from(t).select('*');
    const [e, n, mx, aj, nt, nr] = await Promise.all([q('estudiantes'), q('intervenciones_comunitarias'), q('matriz_gestion_comunitaria'), q('kpi_ajustes_dashboard'),
      supabaseClient.from('notas_academicas').select('estudiante_dni,curso,nota,semestre').eq('semestre', SEM_NOTAS), leerNotasRiesgo()]);
    D.notas = nt.data || []; D.notasErr = !!nt.error;
    D.notasRiesgo = nr.data || []; D.notasRiesgoErr = nr.error ? (nr.error.message || 'error') : '';
    D.mx = mx.data || []; D.mxErr = !!mx.error;
    D.aj = {}; (aj.data || []).forEach(r => { D.aj[r.clave] = Number(r.valor) || 0; }); D.ajErr = !!aj.error;
    D.est = (e.data||[]).map(x => ({...x, estado_academico: normalizarAcademico(x.estado_academico), institucion: canonInst(x.institucion)}));
    D.int = n.data||[];
    $('dashAviso').classList.toggle('hidden', !n.error);
    $('dashAviso').textContent = n.error ? 'Falta la tabla intervenciones_comunitarias en Supabase. Ejecuta supabase_comunidad.sql.' : '';
    poblarFiltros();
    renderTodo();
  }
  // Las opciones del filtro son fijas (lista oficial, sin duplicados) y están en el HTML.
  // Aquí solo se garantiza que la selección actual siga siendo una opción oficial.
  function poblarFiltros(){
    const sel = $('dfInst'); if (!INSTITUCIONES.includes(sel.value)) sel.value = '';
  }
  // Unifica variantes de escritura (Senati / SENATI / senati, con espacios o acentos) a la forma oficial
  function canonInst(txt){
    const t = String(txt || '').trim().replace(/\s+/g, ' ');
    return INSTITUCIONES.find(n => sinAcentos(n) === sinAcentos(t)) || t;
  }
  // Filtro global: Todas = consolidado; una institución = solo sus becarios
  function filtrados(){
    const i = $('dfInst').value;
    return D.est.filter(e => !i || e.institucion === i);
  }
  // Institución de una intervención: por su campo "Institución / Lugar / Grupo"; si no la menciona, por la del becario vinculado (DNI)
  function instDeIntervencion(x){
    const k = claveInst(x.institucion_grupo);
    if (k !== OTROS) return k;
    if (x.estudiante_dni) { const b = D.est.find(e => String(e.dni) === String(x.estudiante_dni)); if (b && INSTITUCIONES.includes(b.institucion)) return b.institucion; }
    return OTROS;
  }

  // ---------- DASHBOARD 1 ----------
  function renderD1(L){
    const total = L.length, act = L.filter(esActivo).length, egr = L.filter(esEgresado), cohorte = L.filter(esCohorteEgreso), baj = L.filter(esBaja).length, sus = L.filter(esSuspension).length, pau = L.filter(esPausa).length;
    // Inserción laboral formal: base = cohorte completa de egreso (egresados + subsanación pendiente), igual que el gráfico y la tabla
    const ins = cohorte.filter(e => condicionEgreso(e) === 'Inserción Laboral Formal').length;
    // Retención real = activos + suspendidos temporales + egresados (retiro voluntario / renuncia / deserción restan)
    const ret = act + sus + egr.length;
    $('d1Kpis').innerHTML =
      kpi('Tasa de retención', fmtPct(ret,total), `${act} activos + ${sus} suspendidos + ${egr.length} egresados de ${total} inscritos`, COL.verde) +
      kpi('Tasa de retiro voluntario / deserción', fmtPct(baj,total), `${baj} retiro(s) / deserción · ${sus} suspensión temporal · ${pau} pausa académica`, COL.rojo) +
      kpi('Inserción laboral formal', fmtPct(ins,cohorte.length), `${ins} de ${cohorte.length} egresados`, COL.azul);

    const insts = [...new Set(L.map(e=>e.institucion||'Sin institución'))].sort();
    const por = (fn) => insts.map(n => L.filter(e => (e.institucion||'Sin institución')===n && fn(e)).length);
    const plugDL = (typeof ChartDataLabels !== 'undefined') ? [ChartDataLabels] : [];
    const series = [
      {label:'Matriculados / Activos', raw:por(esActivo), backgroundColor:COL.verde},
      {label:'Egresados / Titulados', raw:por(esEgresado), backgroundColor:COL.mor},
      {label:'Pausa Académica', raw:por(esPausa), backgroundColor:COL.azulc},
      {label:'Suspensión Temporal', raw:por(esSuspension), backgroundColor:COL.naranja},
      {label:'Retiro Voluntario / Deserción', raw:por(esBaja), backgroundColor:COL.rojo}
    ].map(d => ({ ...d, data: d.raw }));
    const sumar = (arr) => arr.reduce((a, b) => a + b, 0);
    const maxApilado = Math.max(1, ...insts.map((_, i) => series.reduce((a, d) => a + d.raw[i], 0)));
    $('chInstWrap').style.height = '460px';

    // Leyenda lateral compacta: color, situación y conteo (con porcentaje)
    const totalCat = sumar(series.map(d => sumar(d.raw)));
    $('chInstLeyenda').innerHTML = `<div style="border:1px solid var(--border);border-radius:10px;padding:7px 10px;background:var(--surface-alt)">
        ${series.map(d => `<div style="display:flex;align-items:center;gap:6px;padding:3px 0">
          <span style="flex:none;width:9px;height:9px;border-radius:3px;background:${d.backgroundColor}"></span>
          <span style="flex:1;min-width:0;font-size:11px;line-height:1.2;color:var(--ink)">${esc(d.label)}</span>
          <span style="flex:none;font-size:11px;color:var(--ink-muted);white-space:nowrap"><strong style="color:var(--ink)">${sumar(d.raw)}</strong> · ${fmtPct(sumar(d.raw), totalCat)}</span></div>`).join('')}
        <div style="display:flex;justify-content:space-between;margin-top:4px;padding-top:5px;border-top:1px solid var(--border);font-size:11px"><strong>Total</strong><strong>${totalCat}</strong></div></div>`;

    // Todas las cifras dentro de las barras comparten exactamente el mismo tamaño, peso y estilo
    const etiquetaDentro = { display:(ctx) => ctx.dataset.raw[ctx.dataIndex] > 0, color:'#FFFFFF', anchor:'center', align:'center', clamp:true, clip:false,
      font:{ family:'Inter, sans-serif', weight:'700', size:11 },
      textStrokeColor:'rgba(15,25,35,.6)', textStrokeWidth:2.5, formatter:(v, ctx) => ctx.dataset.raw[ctx.dataIndex] };
    dibujar('chInst', { type:'bar', data:{ labels:insts, datasets:series },
      options:{ responsive:true, maintainAspectRatio:false, layout:{ padding:{ top:8, right:6 } },
        datasets:{ bar:{ maxBarThickness:72, barPercentage:.7, categoryPercentage:.8, borderColor:'#FFFFFF', borderWidth:1.5, borderRadius:3 } },
        scales:{ x:{ stacked:true, grid:{ display:false }, ticks:{ font:{ weight:'600' } }, border:{ display:true, color:'#5B6B75', width:1.5 } },

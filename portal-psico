    const bd = { borderRadius:4, borderColor:'#FFFFFF', borderWidth:1.5 };
    const datasets = [
      ...meses.map(m => ({ label:m.nombre, esMes:true, abrev:m.nombre.slice(0, 3), data:[m.total, 0, 0], backgroundColor:m.color, ...bd })),

  // Ambos botones activan la clase body.imprimiendo-ficha, que "desbloquea" el
  // layout del modal (ver reglas CSS arriba, fuera de @media print) para que
  // la estructura sea idéntica en los dos casos y en la pantalla.
  //
  // - "Imprimir" sigue usando la vía nativa del navegador (window.print()),
  //   que sí debe abrir su propio diálogo de impresión estándar.
  // - "Guardar como PDF" ya NO usa window.print(): genera el archivo con
  //   html2pdf y lo descarga directamente al equipo, sin ninguna ventana
  //   flotante de previsualización de por medio.
  function imprimirFichaIntegral(){
    document.body.classList.add('imprimiendo-ficha');
    window.print();
  }
  window.addEventListener('afterprint', () => document.body.classList.remove('imprimiendo-ficha'));

  // ---------- Generación de PDF sin parpadeos ----------
  // Clona el elemento a exportar dentro de un contenedor invisible, colocado
  // fuera de la pantalla (left:-99999px). Así html2canvas captura una copia
  // con layout normal (sin recortes de scroll ni posición fija), mientras la
  // ventana flotante visible en pantalla permanece intacta en todo momento:
  // no se oculta, no cambia de tamaño ni de posición, no hay parpadeo.
  async function generarPDFDesdeElemento(origen, filename, jsPDFOpts){
    const ancho = origen.getBoundingClientRect().width || origen.scrollWidth || 900;
    const contenedor = document.createElement('div');
    contenedor.style.position = 'fixed';
    contenedor.style.top = '0';
    contenedor.style.left = '-99999px';
    contenedor.style.width = ancho + 'px';
    contenedor.style.background = '#ffffff';
    contenedor.style.fontFamily = "'Inter', Arial, sans-serif";
    contenedor.appendChild(origen.cloneNode(true));
    document.body.appendChild(contenedor);

    // Un frame para que el navegador calcule el layout del clon antes de capturarlo.
    await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));

    try {
      await html2pdf().set({
        margin: 14,
        filename,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2, useCORS: true },
        jsPDF: Object.assign({ unit: 'mm', format: 'a4', orientation: 'portrait' }, jsPDFOpts || {}),
        pagebreak: { mode: ['css', 'legacy'] }
      }).from(contenedor.firstElementChild).save();
    } finally {
      contenedor.remove();
    }
  }


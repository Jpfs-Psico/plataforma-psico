        <div class="pdf-meta-centrada"><strong>Institución:</strong> ${esc(filtros)} &nbsp;·&nbsp; <strong>Vista:</strong> ${vista} &nbsp;·&nbsp; <strong>Emitido:</strong> ${hoy}</div></div>`;
      const { clon, imagenes } = clonarPanelParaPDF($('d1MatrizCuerpo'));
      // La matriz se reparte en dos bloques independientes: (1) reglas + indicadores + dona y (2) tabla de becarios,
      // para que la tabla pueda continuar por filas completas en la hoja siguiente sin partir la dona ni los indicadores.
      const reglas = clon.querySelector('.mx-reglas'), izq = clon.querySelector('.mx-izq'), der = clon.querySelector('.mx-der');
      const bloqueSup = document.createElement('div'); bloqueSup.className = 'card';
      if (reglas) bloqueSup.appendChild(reglas);
      if (izq) { izq.style.cssText = 'display:grid;grid-template-columns:minmax(0,3fr) minmax(0,2fr);align-items:center;gap:14px'; bloqueSup.appendChild(izq); }
      const bloqueTabla = document.createElement('div'); bloqueTabla.className = 'card pdf-tabla-card';
      if (der) bloqueTabla.appendChild(der);
      reporte.appendChild(bloqueSup); reporte.appendChild(bloqueTabla);
      document.body.appendChild(envoltorio);
      await Promise.all(imagenes.map(i => i.decode().catch(() => {})));
      await esperarFrames();
      await exportarReportePDF(reporte, `Reporte_Matriz_Alertas_Tempranas_${fecha}.pdf`);
    } catch (err) {
      alert('No se pudo generar el reporte: ' + (err.message || err));
    } finally {
      envoltorio.remove();
      btn.innerHTML = textoBtn;
      botones.forEach(b => { b.disabled = false; });
    }
  }
  $('d1MxPdf').addEventListener('click', (ev) => generarPDFMatriz(ev.currentTarget));
  window.dashGenerarPDF = generarPDFDashboard;   // lo usa el módulo Admin (reporte general y atajos por sección)
})();
</script>

<script>
// ============================================================================
// MÓDULO ADMIN — reportes, resumen ejecutivo, auditoría de documentos y accesos rápidos
// ============================================================================
(function(){
  const $ = (id) => document.getElementById(id);
  const esc = (s) => escHtml(s);
  const GRUPOS = [
    { k:'act', t:'Matriculados / Activos',        c:'#2F7D5B' },
    { k:'egr', t:'Egresados / Titulados',         c:'#7A68A8' },
    { k:'pau', t:'Pausa Académica',               c:'#2F80C9' },
    { k:'sus', t:'Suspensión Temporal',           c:'#E8871E' },
    { k:'baj', t:'Retiro Voluntario / Deserción', c:'#C0504D' } ];
  const BAJAS = ['Retiro voluntario','Deserción','Abandono Definitivo','Retiro Formal','Renuncia Voluntaria Inicial'];
  const grupoDe = (e) => {
    const a = e.estado_academico || '';
    if (a === 'Egresado') return 'egr';
    if (/pausa/i.test(a)) return 'pau';
    if (/suspens|suspendid/i.test(a)) return 'sus';
    if (BAJAS.includes(a)) return 'baj';
    return 'act';
  };
  const pct = (a, b) => b ? Math.round(a / b * 100) : 0;
  const nombreDe = (e) => `${e.apellidos || ''}, ${e.nombres || ''}`.trim();
  const icono = (paths) => `<span class="perfil-icon-tile"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg></span>`;
  const ICO = {
    firma:  '<path d="M4 20h4L18.5 9.5a2.121 2.121 0 0 0-3-3L5 17v3z"/>',
    pin:    '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
    bd:     '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/>',
    fechas: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
    com:    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>' };

  let A = { est:[], docs:[], ses:[], inf:[], notas:[], nCampo:0, nMatriz:0, errDocs:false, errNotas:'' };
  let filtroMx = 'todos', busquedaMx = '';
  let filtro = 'todos', busqueda = '', chart = null, ocupado = false;

  // Notas académicas de todos los becarios (paginadas: Supabase devuelve máx. 1000 filas por consulta)
  async function leerNotas(){
    let out = [], desde = 0; const paso = 1000;
    for (;;) {
      const { data, error } = await supabaseClient.from('notas_academicas').select('estudiante_dni,semestre,curso,nota,observacion,estado').order('id').range(desde, desde + paso - 1);
      if (error) return { data:out, error };
      out = out.concat(data || []);
      if (!data || data.length < paso) return { data:out, error:null };
      desde += paso;
    }
  }

  // ---------- Carga de datos (solo conteos; nunca se descarga el contenido de los PDF) ----------
  const COLS_EST_ADM = 'dni,apellidos,nombres,institucion,estado_academico,factor_riesgo_principal,estado_caso,impacto_psicoemocional,nivel_riesgo_psicologico';
  async function cargar(){
    const q = (t, c) => supabaseClient.from(t).select(c);
    const r = await Promise.all([
      q('estudiantes', COLS_EST_ADM + ',subfactor_riesgo,riesgo_perdida_beca'),
      q('documentos_estudiante', 'id,dni_estudiante,tipo'),
      q('reportes_sesion', 'dni_estudiante'),
      q('informes_psicologicos', 'dni_estudiante'),
      q('intervenciones_comunitarias', 'id'),
      q('matriz_gestion_comunitaria', 'id'),
      leerNotas() ]);
    if (r[0].error && /riesgo_perdida_beca|subfactor_riesgo|column/i.test(r[0].error.message || '')) r[0] = await q('estudiantes', COLS_EST_ADM);   // aún no se ejecutó el SQL de la matriz de alertas tempranas
    const av = $('admAviso');
    av.textContent = r[0].error ? 'No se pudieron cargar los becarios: ' + r[0].error.message : '';
    av.classList.toggle('hidden', !r[0].error);
    A.est = (r[0].data || []).map(e => ({ ...e, estado_academico: normalizarAcademico(e.estado_academico) }));
    A.docs = r[1].data || []; A.errDocs = !!r[1].error;
    A.ses = r[2].data || []; A.inf = r[3].data || [];
    A.nCampo = (r[4].data || []).length; A.nMatriz = (r[5].data || []).length;
    A.notas = r[6].data || []; A.errNotas = r[6].error ? r[6].error.message : '';
  }

  // ---------- KPIs + gráfico consolidado ----------
  const kpi = (t, v, d, c) => `<div class="card rounded-[18px] p-5"><p class="text-xs font-bold uppercase tracking-[.08em]" style="color:var(--ink-muted)">${t}</p>
    <p class="font-display text-3xl font-extrabold mt-1" style="color:${c || 'var(--ink)'}">${v}</p><p class="text-xs mt-1" style="color:var(--ink-muted)">${d || ''}</p></div>`;

  function filasAuditoria(){
    const cnt = (arr) => arr.reduce((m, r) => { const k = String(r.dni_estudiante); m[k] = (m[k] || 0) + 1; return m; }, {});
    const pdf = cnt(A.docs), ses = cnt(A.ses), inf = cnt(A.inf);
    return A.est.map(e => { const k = String(e.dni), p = pdf[k] || 0, s = ses[k] || 0, i = inf[k] || 0; return { e, p, s, i, total:p + s + i }; })
      .sort((a, b) => ((a.total > 0) - (b.total > 0)) || nombreDe(a.e).localeCompare(nombreDe(b.e), 'es', { sensitivity:'base' }));
  }

  function pintarResumen(){
    const total = A.est.length, cuentas = GRUPOS.map(g => A.est.filter(e => grupoDe(e) === g.k).length);
    const casos = A.est.filter(e => e.factor_riesgo_principal && ['atencion', 'evolucion'].includes(scNormEstado(e.estado_caso))).length;
    const aud = filasAuditoria(), con = aud.filter(r => r.total > 0).length;
    $('admKpis').innerHTML =
      kpi('Becarios registrados', total, `${cuentas[0]} activos · ${cuentas[1]} egresados`, 'var(--primary)') +
      kpi('Casos en acompañamiento', casos, 'En atención o con evolución favorable', '#C0504D') +
      kpi('Intervenciones registradas', A.nCampo + A.nMatriz, 'Comunitarias e institucionales', '#7A68A8') +
      kpi('Expedientes con documentos', `${con} / ${total}`, `${pct(con, total)}% de los becarios`, '#2F7D5B');

    $('admLeyenda').innerHTML = total ? `<div style="border:1px solid var(--border);border-radius:10px;padding:7px 10px;background:var(--surface-alt)">
      ${GRUPOS.map((g, i) => `<div style="display:flex;align-items:center;gap:6px;padding:3px 0">
        <span style="flex:none;width:9px;height:9px;border-radius:3px;background:${g.c}"></span>
        <span style="flex:1;min-width:0;font-size:11px;line-height:1.2">${esc(g.t)}</span>
        <span style="flex:none;font-size:11px;color:var(--ink-muted);white-space:nowrap"><strong style="color:var(--ink)">${cuentas[i]}</strong> · ${pct(cuentas[i], total)}%</span></div>`).join('')}
      <div style="display:flex;justify-content:space-between;margin-top:4px;padding-top:5px;border-top:1px solid var(--border);font-size:11px"><strong>Total</strong><strong>${total}</strong></div></div>`
      : '<p class="perfil-sub">Aún no hay becarios registrados.</p>';

    if (chart) { chart.destroy(); chart = null; }
    const cv = $('chAdminEstado'); if (!cv || !total) return;
    const centro = { id:'admCentro', afterDraw(ch){
      const a = ch.chartArea, x = (a.left + a.right) / 2, y = (a.top + a.bottom) / 2, c = ch.ctx;
      c.save(); c.textAlign = 'center'; c.textBaseline = 'middle';
      c.fillStyle = '#16212B'; c.font = '800 32px "Plus Jakarta Sans", sans-serif'; c.fillText(String(total), x, y - 9);
      c.fillStyle = '#5B6B75'; c.font = '600 12px Inter, sans-serif'; c.fillText('becarios', x, y + 16); c.restore(); } };
    chart = new Chart(cv.getContext('2d'), { type:'doughnut',
      data:{ labels:GRUPOS.map(g => g.t), datasets:[{ data:cuentas, backgroundColor:GRUPOS.map(g => g.c), borderColor:'#fff', borderWidth:3, hoverOffset:6 }] },
      options:{ responsive:true, maintainAspectRatio:false, cutout:'62%',
        plugins:{ legend:{ display:false }, tooltip:{ callbacks:{ label:(c) => ` ${c.label}: ${c.raw} becario(s) · ${pct(c.raw, total)}%` } } } },
      plugins:[centro] });
  }

  // ---------- Auditoría de documentos ----------
  function pintarAuditoria(){
    const todas = filasAuditoria(), con = todas.filter(r => r.total > 0).length, pen = todas.length - con;
    $('admAudResumen').innerHTML =
      `<span class="adm-pill" style="background:var(--success-soft);color:var(--success)">✔ Con documentos: ${con}</span>` +
      `<span class="adm-pill" style="background:#FCF3DA;color:#8A6212">● Pendientes: ${pen}</span>`;
    $('admAudBarra').style.width = pct(con, todas.length) + '%';
    const nota = $('admAudNota');
    nota.textContent = A.errDocs ? 'No se pudo leer la tabla de documentos adjuntos (documentos_estudiante): solo se consideran los reportes e informes redactados en el portal.' : '';
    nota.classList.toggle('hidden', !A.errDocs);
    const q = busqueda.trim().toLowerCase();
    const filas = todas.filter(r => (filtro === 'todos' || (filtro === 'con') === (r.total > 0)) && (!q || `${nombreDe(r.e)} ${r.e.dni}`.toLowerCase().includes(q)));
    const num = (n) => n ? `<strong>${n}</strong>` : '<span style="color:var(--ink-muted)">—</span>';
    $('admAudTabla').innerHTML = filas.map(r => `<tr>
      <td class="px-3 py-2"><button type="button" class="font-semibold text-[var(--primary)] hover:underline text-left" data-adm-perfil="${esc(r.e.dni)}">${esc(nombreDe(r.e))}</button></td>
      <td class="px-3 py-2 text-xs">${esc(r.e.institucion || '—')}</td>
      <td class="px-3 py-2 text-center">${num(r.p)}</td><td class="px-3 py-2 text-center">${num(r.s)}</td><td class="px-3 py-2 text-center">${num(r.i)}</td>
      <td class="px-3 py-2">${r.total > 0
        ? '<span class="badge" style="background:var(--success-soft);color:var(--success)">Con documentos</span>'
        : '<span class="badge" style="background:#FCF3DA;color:#8A6212">Pendiente</span>'}</td></tr>`).join('');
    $('admAudVacio').classList.toggle('hidden', filas.length > 0);
  }
  $('admAudFiltros').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-adm-f]'); if (!b) return;
    filtro = b.dataset.admF;
    $('admAudFiltros').querySelectorAll('button').forEach(x => x.classList.toggle('active', x === b));
    pintarAuditoria();
  });
  $('admAudBuscar').addEventListener('input', (ev) => { busqueda = ev.target.value; pintarAuditoria(); });
  $('admAudTabla').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-adm-perfil]'); if (!b) return;
    cambiarSeccionPrincipal('estudiantes'); abrirPerfil(b.dataset.admPerfil);
  });

  // ---------- Matriz de Alertas Preventivas (misma función de riesgo que el semáforo del perfil) ----------
  const NIV = {
    rojo:     { ord:0, emo:'🔴', txt:'Riesgo Alto',  css:'background:rgba(192,80,77,.16);color:#9B3532' },
    amarillo: { ord:1, emo:'🟡', txt:'Riesgo Medio', css:'background:rgba(217,164,65,.22);color:#8A6414' },
    verde:    { ord:2, emo:'🟢', txt:'Riesgo Bajo',  css:'background:rgba(47,125,91,.14);color:#1F6445' },
    sin:      { ord:3, emo:'⚪', txt:'Sin datos',    css:'background:rgba(154,168,176,.2);color:#5C6A73' } };
  const PSI = { alto:'🔴 Alto / Crítico', medio:'🟡 Preventiva', bajo:'🟢 Bajo / resuelto', sin:'—' };
  function filasMatriz(){
    const por = {}; A.notas.forEach(n => { const k = String(n.estudiante_dni); (por[k] = por[k] || []).push(n); });
    return A.est.filter(e => ['act', 'pau', 'sus'].includes(grupoDe(e)))   // se excluyen egresados y bajas
      .map(e => ({ e, r:window.rendEvaluarRiesgo(e, por[String(e.dni)] || []) }))
      .sort((a, b) => NIV[a.r.nivel].ord - NIV[b.r.nivel].ord || b.r.graves - a.r.graves
        || (a.r.prom == null) - (b.r.prom == null) || (a.r.prom || 0) - (b.r.prom || 0)
        || nombreDe(a.e).localeCompare(nombreDe(b.e), 'es', { sensitivity:'base' }));
  }
  function pintarMatriz(){
    const todas = filasMatriz();
    const n = (k) => todas.filter(x => x.r.nivel === k).length;
    $('admMxResumen').innerHTML = ['rojo', 'amarillo', 'verde'].map(k => `<span class="adm-pill" style="${NIV[k].css}">${NIV[k].emo} ${NIV[k].txt.replace('Riesgo ', '')}: ${n(k)}</span>`).join('') +
      (n('sin') ? `<span class="adm-pill" style="${NIV.sin.css}">${NIV.sin.emo} Sin datos: ${n('sin')}</span>` : '');
    const nota = $('admMxNota');
    nota.textContent = A.errNotas ? 'No se pudo leer la tabla de notas (notas_academicas): la Variable A no está disponible. ' + A.errNotas : '';
    nota.classList.toggle('hidden', !A.errNotas);
    const q = busquedaMx.trim().toLowerCase();
    const filas = todas.filter(x => (filtroMx === 'todos' || x.r.nivel === filtroMx) && (!q || `${nombreDe(x.e)} ${x.e.dni}`.toLowerCase().includes(q)));
    $('admMxTabla').innerHTML = filas.map(({ e, r }) => {
      const u = NIV[r.nivel], det = r.nivel === 'sin' ? 'Sin notas cargadas ni caso psicológico registrado' : `${u.txt}: ${r.motivos.join(' + ')}`;
      return `<tr>
        <td class="px-3 py-2"><button type="button" class="font-semibold text-[var(--primary)] hover:underline text-left" data-mx-perfil="${esc(e.dni)}">${esc(nombreDe(e))}</button></td>
        <td class="px-3 py-2 text-xs">${esc(e.institucion || '—')}</td>
        <td class="px-3 py-2 text-center">${r.prom == null ? '<span style="color:var(--ink-muted)">—</span>' : `<strong>${String(Number(r.prom.toFixed(2))).replace('.', ',')}</strong><span class="block text-[10px]" style="color:var(--ink-muted)">${esc(r.sem)}</span>`}</td>
        <td class="px-3 py-2 text-center">${r.desap ? `<strong style="color:#9B3532">${r.desap}</strong>` : '<span style="color:var(--ink-muted)">0</span>'}</td>
        <td class="px-3 py-2 text-xs">${PSI[r.psico]}</td>
        <td class="px-3 py-2"><span class="badge" style="${u.css};cursor:help" title="${esc(det)}" aria-label="${esc(det)}">${u.emo} ${u.txt}</span></td>
        <td class="px-3 py-2 text-center"><button type="button" class="btn-ghost rounded-lg px-3 py-1.5 text-xs font-semibold" data-mx-perfil="${esc(e.dni)}">Ver perfil →</button></td></tr>`;
    }).join('');
    $('admMxVacio').classList.toggle('hidden', filas.length > 0);
  }
  $('admMxFiltros').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-mx-f]'); if (!b) return;
    filtroMx = b.dataset.mxF;
    $('admMxFiltros').querySelectorAll('button').forEach(x => x.classList.toggle('active', x === b));
    pintarMatriz();
  });
  $('admMxBuscar').addEventListener('input', (ev) => { busquedaMx = ev.target.value; pintarMatriz(); });
  $('admMxTabla').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-mx-perfil]'); if (!b) return;
    cambiarSeccionPrincipal('estudiantes'); abrirPerfil(b.dataset.mxPerfil);
  });

  // ---------- Accesos rápidos ----------
  function pintarAccesos(){
    const col = (typeof obtenerColegiatura === 'function') ? obtenerColegiatura() : '';
    const abierto = (typeof spDesbloqueado === 'function') ? spDesbloqueado() : false;
    const fila = (id, ico, t, d, go, estatico) => `<${estatico ? 'div' : 'button type="button"'} class="adm-quick${estatico ? ' adm-static' : ''}" ${estatico ? '' : `data-adm-acc="${id}"`}>
      ${icono(ico)}<span class="adm-txt"><strong>${t}</strong><span>${d}</span></span>${go ? `<span class="adm-go" ${estatico ? `data-adm-acc="${id}" style="cursor:pointer"` : ''}>${go}</span>` : ''}</${estatico ? 'div' : 'button'}>`;
    $('admAccesos').innerHTML =
      fila('firma', ICO.firma, 'Firma profesional', col ? `N.º de colegiatura CPsP ${esc(col)}` : 'Sin N.º de colegiatura registrado', 'Configurar') +
      fila('pin', ICO.pin, 'Seguimiento psicológico protegido', abierto ? 'Desbloqueado en esta sesión' : 'Bloqueado con PIN', abierto ? 'Bloquear ahora' : '', true) +
      fila('bd', ICO.bd, 'Base de datos de becarios', 'Descarga el consolidado en PDF', 'Descargar') +
      fila('fechas', ICO.fechas, 'Reporte de atenciones por fechas', 'Consulta las sesiones de un rango de fechas', 'Abrir') +
      fila('com', ICO.com, 'Intervención comunitaria', 'Registro de acciones de campo', 'Abrir');
  }
  $('admAccesos').addEventListener('click', (ev) => {
    const b = ev.target.closest('[data-adm-acc]'); if (!b) return;
    const a = b.dataset.admAcc;
    if (a === 'firma') $('btnFirmaProfesional').click();
    else if (a === 'pin') { const x = document.querySelector('[data-sp-bloquear]'); if (x) x.click(); pintarAccesos(); }
    else if (a === 'bd') $('btnDescargarBD').click();
    else if (a === 'fechas') cambiarSeccionPrincipal('reportes');
    else if (a === 'com') $('navComunidad').click();
  });
  $('formFirma').addEventListener('submit', () => setTimeout(pintarAccesos, 0));

  // ---------- Reportes PDF (reutilizan el generador del Dashboard) ----------
  async function generar(modo, seccion, btn){
    if (ocupado) return;
    ocupado = true;
    try {
      const textoPrevio = btn.innerHTML;
      btn.disabled = true; btn.textContent = 'Preparando datos…';
      try { await window.refrescarDashboards(); } catch (err) { console.warn('No se pudieron refrescar los datos del Dashboard:', err); }
      btn.disabled = false; btn.innerHTML = textoPrevio;
      await window.dashGenerarPDF(modo, btn, seccion);
    } finally { ocupado = false; }
  }
  $('admPdfGeneral').addEventListener('click', (ev) => generar('general', null, ev.currentTarget));
  [1, 2, 3].forEach(n => $('admPdf' + n).addEventListener('click', (ev) => generar('actual', n, ev.currentTarget)));

  // ---------- Apertura del módulo ----------
  async function abrirAdmin(){
    cambiarSeccionPrincipal('admin');
    pintarAccesos();
    await cargar();
    pintarResumen(); pintarMatriz(); pintarAuditoria();
  }
  $('btnAdmin').addEventListener('click', abrirAdmin);
  $('admRefrescar').addEventListener('click', abrirAdmin);
})();
</script>


<script>
// ============================================================================
// MODO COORDINACIÓN Y SUPERVISIÓN — consulta / solo lectura administrativa
// ============================================================================
(function(){
  const $ = (id) => document.getElementById(id);
  // El área clínica nunca se desbloquea en esta vista (no hay PIN): no se consulta la bitácora privada
  window.spDesbloqueado = function(){ return false; };
  // Estado y observación del perfil: solo lectura
  ['perfilEstadoActual', 'perfilObservaciones'].forEach(id => { const n = $(id); if (n) n.disabled = true; });
  // Firma profesional: sin guardado
  const ff = $('formFirma');
  if (ff) ff.addEventListener('submit', (ev) => { ev.preventDefault(); ev.stopImmediatePropagation(); }, true);
  // Tabla de estudiantes: los desplegables en línea quedan inhabilitados
  const tb = $('tablaEstudiantes');
  const bloquearSelects = () => tb.querySelectorAll('select:not(:disabled)').forEach(x => { x.disabled = true; });
  if (tb) { new MutationObserver(bloquearSelects).observe(tb, { childList:true }); bloquearSelects(); }
  // Al abrir un perfil se cargan solo los PDF cargados (documentos adjuntos), sin bitácora clínica
  const abrirOriginal = window.abrirPerfil;
  window.abrirPerfil = async function(dni){
    await abrirOriginal(dni);
    try { await cargarDocumentos(); } catch (err) { console.warn('Documentos no disponibles:', err); }
  };
})();
</script>

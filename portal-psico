  function agruparPorMesHTML(registros, obtenerFecha, renderTarjeta){
    const grupos = [];
    const indicePorClave = {};

    registros.forEach(r => {
      const fecha = new Date(obtenerFecha(r) + 'T00:00:00');
      const clave = `${fecha.getFullYear()}-${fecha.getMonth()}`;
      if (!(clave in indicePorClave)) {
        const etiqueta = fecha.toLocaleDateString('es-PE', { month: 'long', year: 'numeric' });
        indicePorClave[clave] = grupos.length;
        grupos.push({ etiqueta: etiqueta.charAt(0).toUpperCase() + etiqueta.slice(1), items: [] });
      }
      grupos[indicePorClave[clave]].items.push(r);
    });

    return grupos.map(grupo => `
      <div>
        <p class="text-xs uppercase tracking-[.1em] text-[var(--ink-muted)] font-bold mb-3">${grupo.etiqueta}</p>
        <div class="space-y-3">
          ${grupo.items.map(renderTarjeta).join('')}
        </div>
      </div>
    `).join('');
  }


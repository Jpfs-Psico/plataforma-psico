    // Se normaliza (recorta espacios y unifica "2", " 2", "02") para evitar duplicados, y se ordena numéricamente
    const ciclos = [...new Set(estudiantes.map(e => normCiclo(e.ciclo)).filter(c => c && c !== '-'))]

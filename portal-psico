  .pdf-reporte .grid{ display:grid !important; gap:8px !important; margin:0 0 8px !important; }
  .pdf-reporte .card{ box-shadow:none !important; border:1px solid #D9DFE3 !important; border-radius:8px !important; padding:10px 12px !important; margin:0 0 8px !important; break-inside:avoid; page-break-inside:avoid; }
  .pdf-reporte .grid > .card{ margin:0 !important; }
  .pdf-reporte .card.pdf-tabla-card{ break-inside:auto; page-break-inside:auto; }
  .pdf-reporte .grid, .pdf-reporte img, .pdf-reporte .pdf-seccion-titulo, .pdf-reporte .pdf-portada, .pdf-reporte .pdf-cabecera{ break-inside:avoid; page-break-inside:avoid; }

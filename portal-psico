  .perfil-icon-tile{ width:36px; height:36px; flex:none; border-radius:11px; display:inline-flex; align-items:center; justify-content:center; background:var(--primary-soft); color:var(--primary); }
  #vistaPerfil .perfil-tabs{ display:inline-flex; gap:.25rem; padding:.3rem; background:var(--surface-alt); border:1px solid var(--border); border-radius:14px; max-width:100%; overflow-x:auto; }
  #vistaPerfil .subtab{ border:0; border-radius:10px; padding:.5rem .95rem; display:inline-flex; align-items:center; gap:.5rem; white-space:nowrap; }
  #vistaPerfil .subtab.active{ background:var(--surface); color:var(--primary); box-shadow:0 1px 2px rgba(22,33,43,.08), 0 6px 12px -6px rgba(22,33,43,.14); }
  .tab-count{ min-width:1.35rem; height:1.35rem; padding:0 .4rem; border-radius:999px; background:var(--border); color:var(--ink-muted); font-size:.6875rem; font-weight:700; display:inline-flex; align-items:center; justify-content:center; }
  #vistaPerfil .subtab.active .tab-count{ background:var(--primary); color:#fff; }
  #vistaPerfil .item-row{ box-shadow:none; transition:border-color .2s var(--ease), box-shadow .2s var(--ease); }
  #vistaPerfil .item-row:hover{ border-color:#CBD5D0; box-shadow:0 8px 18px -12px rgba(22,33,43,.25); }
  .item-row .btn-ghost svg{ display:inline; margin-right:.3rem; vertical-align:-2px; }
  .doc-ico{ width:40px; height:40px; flex:none; border-radius:12px; display:inline-flex; align-items:center; justify-content:center; background:var(--primary-soft); color:var(--primary); }
  .doc-ico-informe{ background:var(--success-soft); color:var(--success); }
  .doc-tag{ display:inline-block; margin-left:.4rem; padding:.05rem .45rem; border-radius:999px; font-size:.625rem; font-weight:700; letter-spacing:.02em; vertical-align:1px; background:var(--surface-alt); color:var(--ink-muted); }
  .empty-state{ border:1.5px dashed #CBD5D0; border-radius:16px; padding:2rem 1rem; text-align:center; color:var(--ink-muted); font-size:.875rem; line-height:1.5; }
  .empty-state strong{ display:block; color:var(--ink); font-size:.9375rem; margin-bottom:.2rem; }
  .empty-state svg{ margin:0 auto .6rem; color:#9AA8B0; }

  /* ==========================================================================
     BLOQUEO CON PIN — Seguimiento psicológico del perfil
     ========================================================================== */
  .sp-lock{ text-align:center; padding:22px 14px; border:1.5px dashed var(--border); border-radius:16px; background:var(--surface-alt); }
  .sp-lock-icon{ display:inline-flex; align-items:center; justify-content:center; width:46px; height:46px; border-radius:14px; background:var(--surface); color:var(--primary); border:1px solid var(--border); margin-bottom:10px; }
  .sp-lock .perfil-sub{ max-width:380px; margin:4px auto 0; }
  .sp-lock-form{ display:flex; gap:8px; justify-content:center; flex-wrap:wrap; margin-top:14px; }
  .sp-lock-form input::placeholder{ letter-spacing:0; font-size:13px; }
  .sp-lock-form input{ width:170px; border-radius:12px; padding:9px 12px; font-size:14px; text-align:center; letter-spacing:.18em; border:1px solid var(--border); background:var(--surface); }
  .sp-lock-msg{ margin-top:10px; font-size:12.5px; font-weight:600; color:var(--danger); }
  .sp-lock.sp-shake{ animation:spShake .35s; }
  @keyframes spShake{ 0%,100%{transform:translateX(0)} 25%{transform:translateX(-6px)} 75%{transform:translateX(6px)} }

  /* ==========================================================================
     REPORTE / PDF DE DASHBOARDS — compacto, uniforme y de una sola dirección visual
     Se aplica al contenedor .pdf-reporte que genera el botón "Generar Reporte / PDF".
     ========================================================================== */
  .pdf-reporte{ box-sizing:border-box; width:100%; margin:0 auto; padding:0 6px; background:#fff; color:#16212B; font-family:'Inter',Arial,sans-serif; font-size:11px; line-height:1.4;
    -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .pdf-reporte *{ box-sizing:border-box; }
  .pdf-reporte .pdf-cabecera{ display:flex; justify-content:space-between; align-items:flex-end; gap:16px; padding-bottom:8px; margin-bottom:12px; border-bottom:2px solid #1B3A57; }
  .pdf-reporte .pdf-eyebrow{ font-size:9px; letter-spacing:.12em; text-transform:uppercase; color:#5B6B75; font-weight:700; }
  .pdf-reporte .pdf-titulo{ font-family:'Plus Jakarta Sans',sans-serif; font-size:17px; font-weight:800; color:#1B3A57; line-height:1.2; margin-top:2px; }

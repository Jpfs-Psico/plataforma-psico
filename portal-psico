  /* ==========================================================================
     MATRIZ DE ALERTAS PREVENTIVAS Y SEMÁFORO DE RIESGO (Dashboard 1 · 4.ª sección) — bloque compacto y simétrico
     ========================================================================== */
  .mx-grid{ display:grid; grid-template-columns:minmax(0,2fr) minmax(0,3fr); gap:20px; align-items:stretch; }

    const nombreArchivo = base.trim().replace(/\s+/g, '_') + '.pdf';

    try {
      await generarPDFDesdeElemento($('vdPrintArea'), nombreArchivo, { orientation: 'portrait' });
    } catch (err) {
      alert('No se pudo generar el PDF: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = textoOriginal;
    }
  }


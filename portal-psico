  const msgEd = (t) => { const m = $('d3EdMsg'); if (m) { m.textContent = t; m.classList.toggle('hidden', !t); } };
  $('d3BtnNuevo').addEventListener('click', () => { d3Edit = 'nuevo'; d3Pag = 1; pintarMatrizD3(); const el = $('d3EdInst'); if (el) el.focus(); });
  $('d3Matriz').addEventListener('click', async (ev) => {
    const ed = ev.target.closest('[data-d3-editar]'), del = ev.target.closest('[data-d3-eliminar]');

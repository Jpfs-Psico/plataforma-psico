    const { data, error } = await supabaseClient
      .from('reportes_sesion')
      .select('fecha_atencion, estudiantes ( apellidos, nombres, institucion, carrera )')
      .gte('fecha_atencion', inicio)
      .lte('fecha_atencion', fin)
      .order('fecha_atencion');

    $('rfBtnBuscar').disabled = false;
    $('rfBtnBuscar').textContent = 'Buscar atenciones';

    if (error) { alert('Error al buscar: ' + error.message); return; }

    rfFilas = (data || [])
      .filter(r => r.estudiantes)
      .map(r => ({
        apellidos: r.estudiantes.apellidos,
        nombres: r.estudiantes.nombres,
        institucion: r.estudiantes.institucion,
        carrera: r.estudiantes.carrera,
